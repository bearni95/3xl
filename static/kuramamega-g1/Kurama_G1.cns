trigger1 = AnimElem = 2
value = s4,6

[State 1125, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 1125

[State 1125, 移動]
type = PosSet
trigger1 = time = 0
y = 0

[State 1125, 移動]
type = Veladd
trigger1 = time >= 0 && AnimElemtime(8) <= 4
x = .1

[State 1125, 移動終了]
type = VelSet
trigger1 = AnimElemtime(8) = 5
x = 0

[State 1125,]
type = MakeDust
trigger1 = vel x < 0
spacing = 4

[State 1125, 1]
type = SelfState
trigger1 = Animtime = 0
trigger1 = Alive
value = 5120

[State 820, 1]
type = SelfState
trigger1 = Animtime = 0
trigger1 = !Alive
value = 5150



