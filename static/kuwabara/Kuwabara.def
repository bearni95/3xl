; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Kuwabara Kazuma"        ;Name of character
displayname = "Kuwabara Kazuma" ;Name of character to display
versiondate = 07,31,2000    ;Version date of character
mugenversion = 07,31,2000   ;Version of M.U.G.E.N character works on
author = "Abdul"         ;Character author name
pal.defaults = 1,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd      = Kuwabara.cmd   ;Command set
cns      = Kuwabara.cns   ;Constants
st       = Kuwabara.cns   ;States
stcommon = common1.cns    ;Common states
sound    = Kuwabara.snd
sprite   = Kuwabara.sff   ;Sprite
anim     = Kuwabara.air   ;Animation
pal1     = Kuwabara1.act  ;Palettes (can have up to 12)
pal2     = Kuwabara2.act
pal4     = Kuwabara3.act
pal5     = Kuwabara4.act

