;---------------------------------------------------------------------------
; AGUARDHIT (shaking)
[Statedef 154]
type    = A
movetype= H
physics = N

[State -2, 2]
type = VarSet
trigger1 = !time
fvar(6) = vel x

[State -2, 3]
type = VarSet
trigger1 = !time
fvar(7) = vel y

[State 0, VelSet]
type = VelSet
trigger1 = !time
x = 0
y = 0

[State 154, 1]
type = ChangeAnim
trigger1 = 1
value = 152

[State 154, 2]
type = ChangeState
trigger1 = HitShakeOver
value = 155 ;AGUARDHIT2

[State 154, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 4

