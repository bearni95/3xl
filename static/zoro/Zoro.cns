x = -6.8
y = -4.8

[State 105, 5]
type = VelMul
trigger1 = AnimElemTime(2) > 0
x = .98

[State 105, 6]
type = VelAdd
trigger1 = AnimElemTime(2) > 0
y = .65

[state 192, 2]
type = playsnd
trigger1 = animelem = 1
value = s5547, 0

[State 105, 7]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

