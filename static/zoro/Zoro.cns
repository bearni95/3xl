movetype= a
physics = n
ctrl = 1
anim = 110
sprpriority = 1

[state 100, 1]
type = velset
trigger1 = time = 0
x = 7
y = 0

[state 192, 2]
type = playsnd
trigger1 = animelem = 1
value = 0, 17

[state 100, 4]
type = explod
trigger1 = time = 4
id = 100
anim = 9100
postype = p1
pos = 0,0
ownpal = 1
bindtime = 1
sprpriority = 5
persistent = 0
removeongethit = 1

[state 100, 6]
