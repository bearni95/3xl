;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, Jump Sound]
type = PlaySnd
triggerall = Time = 1
;trigger1 = stateno = 100 ;Jump 
trigger1 = stateno = 40
value = 0, 5

[State -3, dash fwd and back Sound]
type = PlaySnd
triggerall = time = 5
trigger1 = stateno = 100 ;Jump 
trigger2 = stateno = 105
value = 0, 6


[State 640, slamp on the floor sound]
type = PlaySnd
trigger1 = Time = 1
trigger1 = stateno = 5100 
value = 200,6

