;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, Fireball hit SPARK]
type = Explod
trigger1 = (projguarded1001 = 1)  && (numexplod(6300) = 0)
anim = 6300
id = 6300
pos =enemy,const(size.mid.pos.x),enemy,const(size.mid.pos.y)
postype = p2
bindtime = 100
bind = p2
sprpriority = 3

