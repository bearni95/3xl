
[Info]
name = "Ranma"        ;Name of character
displayname = "Ranma" ;Name of character to display
versiondate = 09,30,2016    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Ironjw"         ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference (up to 4)
localcoord = 320,240        ;Local coordinate space width and height

[Files]
cmd     = Ranma.cmd           ;Command set
cns     = Ranma.cns           ;Constants
st      = Ranma.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = Ranma.sff           ;Sprite
anim    = Ranma.air           ;Animation
sound   = Ranma.snd           ;Sound
ai      = Ranma.ai            ;AI hints data (not used)


[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 1
b = 2
c = 3

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
