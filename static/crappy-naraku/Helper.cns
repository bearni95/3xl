value = SCA

[State 1600, Projectile]
; Soul Collectors move out of the Spawn Point
type = Projectile
trigger1 = AnimElem = 3
projanim = 1501
projremove = 0
projhits = 1
projedgebound = 150
postype = p1
projremovetime = 10
offset = 0,0
velocity = 0,0
sparkxy = 189,0
attr = S, SP
damage = 20,10
animtype = heavy
guardflag = MA
hitflag = MAF
hitsound = S1500, 1
guardsound = S6, 0
ground.type = High
ground.slidetime = 10
ground.hittime  = 15
ground.velocity = -2, -2
air.velocity = -4, -2
guard.velocity = -4
air.hittime = 20
fall = 1
air.fall = 1
getpower = 20,10
givepower = 4, 2
projscale = 1,1
hitcountpersist = 1

[State 1600, DestroySelf]
type = DestroySelf
trigger1 = AnimTime = 0

