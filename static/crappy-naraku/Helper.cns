; Spawn Point for Soul Collectors (Purification)
[Statedef 1600]
type    = S
movetype= A
physics = S
juggle  = 1
velset = 0,0
anim = 1502
ctrl = 0
sprpriority = 3

[State 1600, NotHitBy]
