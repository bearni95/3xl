; Kikyo's Curse Deflector
[Statedef 2100]
type    = S
movetype= A
physics = S
juggle  = 2
velset = 0,0
anim = 2001
ctrl = 0
sprpriority = 1

[State 2100, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 2100, Stay In Place]
type = BindToRoot
trigger1 = 1
facing = 1
pos = 0,-54
time = 1

[State 2100, NoPush]
; Kikyo Can't be pushed back when using
type = PlayerPush
trigger1 = 1
value = 0

[State 2100, AngleDraw]
type = AngleDraw
trigger1 = Time < 8
trigger2 = Time > 16
ignorehitpause = 1
scale = 1,1

[State 2100, AngleDraw]
type = AngleDraw
trigger1 = Time = 8
ignorehitpause = 1
scale = 1.125,1.125

[State 2100, AngleDraw]
type = AngleDraw
trigger1 = Time = 10
ignorehitpause = 1
scale = 1.25,1.25

[State 2100, AngleDraw]
type = AngleDraw
trigger1 = Time = 12
ignorehitpause = 1
scale = 1.375,1.375

[State 2100, AngleDraw]
type = AngleDraw
trigger1 = Time = 14
ignorehitpause = 1
scale = 1.5,1.5

[State 2100, DestroySelf]
type = DestroySelf
trigger1 = Time >=28

