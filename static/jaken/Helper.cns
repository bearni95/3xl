;---------------------------------------------------------------------------
; Ceiling Helper
[Statedef 995]
type    = A
movetype= I
physics = N
anim = 3604
velset = 0,0
sprpriority = 2

[State 995, Offscreen]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 995, Safety]; Just in case your opponent is very poorly coded.
type = SelfState
trigger1 = !IsHelper
value = 5050

[State 995, Facing]
type = Turn
trigger1 = facing != parent, facing

[State 995, PosAdd]
type = PosAdd
trigger1 = 1
y = - ScreenPos y

[State 995, PosSet]
type = PosSet
trigger1 = 1
y = ifelse(pos y > - 300, -300, pos y)
x = parent, pos x

[State 995, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 995, Push]
type = PlayerPush
trigger1 = 1
value = 0

[State 995, ChangeAnim]
type = ChangeAnim
trigger1 = (parent, statetype = A) && (parent, MoveContact = 1)
value = 960

[State 995, Timer]
type = Varset
trigger1 = (parent, statetype = A) && (parent, MoveContact = 1)
;trigger1 = var(33) = 0
var(33) = parent, var(33)

[State 995, ChangeAnim]
type = ChangeAnim
trigger1 = parent, statetype != A
trigger2 = !(parent, MoveContact) && (var(33) + 20 <= (parent, var(33)))
value = 3604

[State 995, Timer Reset]
type = Varset
trigger1 = Anim != 960
var(33) = 0
