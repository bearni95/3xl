; HIT_AIRFALLRECOVER
[Statedef 5210]
type    = A
movetype= I
physics = N
ctrl = 0

[State 5210, 5] ;Air
type = ChangeState
trigger1 = time = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

;---------------------------------------------------------------------------
; Statedef -2 AI Stuff
; Within StateDef -2, none of your own AI-related code should be placed
; above these next two controllers.

[State -2, StopAI]
type = VarSet
triggerall = var(58) > 0 && !IsHelper
trigger1 = RoundState != 2
trigger2 = !Alive
var(58) = -2
IgnoreHitPause = 1

; This controller is optional.  It allows you treat the AI flag as a boolean
; value rather than an integer value, letting you trigger your AI directives
; with "var(0)" instead of "var(58)>0", and letting you make moves usable only
; by humans by using "!var(0)" instead of "var(58)<1", thus slightly improving
; the size and efficiency of your code.
; Another benefit is that it makes it much easier for users to disable your AI,
; if they so choose.
[State -2, Simplifier]
type = VarSet
triggerall = !IsHelper
trigger1 = var(58) = 1
trigger2 = var(0):=0
var(0) = 1  ; Another option is to replace 1 with something like MatchNo, if
            ; you want to design your AI to have varying levels of difficulty.
IgnoreHitPause = 1


;---------------------------------------------------------------------------
; Stage Center Helper
[State -2, Stage Center Helper]
type = Helper
trigger1 = numhelper(456) = 0
helpertype = normal
name = "Stage Center Helper"
ID = 456
pos = 160,-120;-99999
postype = back
facing = 1
stateno = 990
keyctrl = 0
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
size.xscale = 1
size.yscale = 1
size.ground.back = 0
size.ground.front = 0
size.air.back = 0
size.air.front = 0
size.height = 0
size.proj.doscale = 0
size.head.pos = 0,0
size.mid.pos = 0,0
size.shadowoffset = 0

;---------------------------------------------------------------------------
; Ceiling Helper
[State -2, Ceiling Helper]
type = Helper
trigger1 = numhelper(789) = 0
helpertype = normal
name = "Ceiling Helper"
ID = 789
pos = 160,-150
postype = back
facing = 1
stateno = 995
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0
size.xscale = 1
size.yscale = 1
size.ground.back = 0
size.ground.front = 0
size.air.back = 0
size.air.front = 0
size.height = 0
size.proj.doscale = 0
size.head.pos = 0,0
size.mid.pos = 0,0
size.shadowoffset = 0

[State -2, Ceiling Y Axis]
type = VarSet
trigger1 = 1
fvar(22) = helper(789), pos y

[State -2, Hit Ceiling]
type = PosSet
trigger1 = numhelper(789) > 0
;trigger1 = helper(789), anim = 960
trigger1 = pos y - Const(size.height) < fvar(22)
y = fvar(22) + Const(size.height)
ignorehitpause = 1

;---------------------------------------------------------------------------
; Low Health Damage Reduction
[State -2, Low Health Damage Reduction]
type = DefenceMulSet
trigger1 = 1
value = (.0005*life + .5);**(-1)

;---------------------------------------------------------------------------
; Scaling fix, if you want
[State -2, xscale]
type = VarSet
trigger1 = 1
fvar(23) = Const(size.xscale)

[State -2, xscale]
type = VarSet
trigger1 = 1
fvar(24) = Const(size.yscale)

;---------------------------------------------------------------------------
; Enemy IDs get
[State -2, Enemy 1 Reset]
type = VarSet
trigger1 = GameTime = 0
var(35) = 0

[State -2, Enemy 2 Reset]
type = VarSet
trigger1 = GameTime = 0
var(36) = 0

[State -2, Enemy 1]
type = VarSet
trigger1 = var(35) = 0
var(35) = enemy(0), id

[State -2, Enemy 2]
type = VarSet
trigger1 = numenemy = 2
trigger1 = var(36) = 0
var(36) = enemy(1), id

;---------------------------------------------------------------------------
; Guard Cancel Helper
[State -2, Make Guard Cancel Helper]
type = Helper
trigger1 = prevstateno = [150,155]
trigger1 = (stateno = [1000,4999])
trigger1 = time = 1
trigger1 = NumHelper(150) < 1
helpertype = normal
name = "Guard Cancel"
ID = 150
pos = Floor(Const(size.xscale) * Const(size.mid.pos.x)), Floor(Const(size.yscale) * Const(size.mid.pos.y))
postype = p1
facing = 1
stateno = 960
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0
size.xscale = Const(size.xscale)
size.yscale = Const(size.yscale)
size.ground.back = 0
size.ground.front = 0
size.air.back = 0
size.air.front = 0
size.height = 0
size.proj.doscale = 0
size.head.pos = 0,0
size.mid.pos = 0,0
size.shadowoffset = 0

;---------------------------------------------------------------------------
; Gives bar when Fireballs hit
[State -2, Fireball PowerAdd]
type = PowerAdd
trigger1 = NumHelper(10) > 0
trigger1 = ((helper(10), MoveHit) = 1)
trigger2 = NumHelper(20) > 0
trigger2 = ((helper(20), MoveHit) = 1)
value = Floor(ifelse(fvar(16) < 50, 8 * (1 - (3 * (fvar(16)/200))), 8 / 4)) * 20

;---------------------------------------------------------------------------
; Damage Cancel Stuff
; Damage Cancel Check to make sure the enemy isn't in a Super
[State -2, Damage Cancel Check 1]
type = VarSet
trigger1 = movetype != H
var(14) = 1

; Damage Cancel Check to make sure the enemy isn't in a Super
[State -2, Damage Cancel Check 3]
type = VarSet
trigger1 = (NumEnemy = 1) && !(playerID(var(35)), HitDefAttr = SCA, HA, HT, HP) ;stateno = [3000,4999])
trigger1 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5030) || (stateno = 5080)
trigger1 = time > 1
trigger2 = (NumEnemy > 1)
trigger2 = var(36) != 0
trigger2 = !(playerID(var(35)), HitDefAttr = SCA, HA, HT, HP) && !(playerID(var(36)), HitDefAttr = SCA, HA, HT, HP) ;stateno = [3000,4999])
trigger2 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5030) || (stateno = 5080)
trigger2 = time > 1
var(14) = 1

; Damage Cancel Check to make sure the enemy isn't in a Super
[State -2, Damage Cancel Check 2]
type = VarSet
trigger1 = (NumEnemy = 1) && ((playerID(var(35)), HitDefAttr = SCA, HA, HT, HP) || (playerID(var(35)), stateno = [3000,4999]))
trigger1 = movetype = H
trigger1 = !HitOver
trigger2 = (NumEnemy > 1)
trigger2 = var(36) != 0
trigger2 = ((playerID(var(35)), HitDefAttr = SCA, HA, HT, HP) || (playerID(var(35)), stateno = [3000,4999])) || ((playerID(var(36)), HitDefAttr = SCA, HA, HT, HP) || (playerID(var(36)), stateno = [3000,4999]))
trigger2 = movetype = H
trigger2 = !HitOver
var(14) = 0

;---------------------------------------------------------------------------
; Shortcut Limiters
; Shortcut 1 Limiter
[State -2, Shortcut 1 Limiter]
type = VarSet
trigger1 = (var(45) + 120) <= var(33)
var(45) = 0
ignorehitpause = 1

; Shortcut 2 Limiter
[State -2, Shortcut 2 Limiter]
type = VarSet
trigger1 = (var(46) + 120) <= var(33)
var(46) = 0
ignorehitpause = 1

; Shortcut 3 Limiter
[State -2, Shortcut 3 Limiter]
type = VarSet
trigger1 = (var(47) + 120) <= var(33)
var(47) = 0
ignorehitpause = 1

;---------------------------------------------------------------------------
; Damage Scaling
; Normal Damage scaling lawl
[State -2, Normals Scaling Reset]
type = VarSet
trigger1 = NumEnemy = 1
trigger1 = Enemy, movetype != H
trigger2 = NumEnemy = 2
trigger2 = ifelse((PlayerID(var(35)), alive), (PlayerID(var(35)), movetype != H), 1)
trigger2 = ifelse((PlayerID(var(36)), alive), (PlayerID(var(36)), movetype != H), 1)
fvar(15) = 0

[State -2, Normals Scaling]
type = VarSet
trigger1 = stateno = [200, 799]
trigger1 = MoveHit = 1
fvar(15) = fvar(15) + 1

; Special Damage scaling lawl
[State -2, Specials Scaling Reset]
type = VarSet
trigger1 = NumEnemy = 1
trigger1 = Enemy, movetype != H
trigger2 = NumEnemy = 2
trigger2 = ifelse((PlayerID(var(35)), alive), (PlayerID(var(35)), movetype != H), 1)
trigger2 = ifelse((PlayerID(var(36)), alive), (PlayerID(var(36)), movetype != H), 1)
fvar(16) = 0

[State -2, Specials Scaling]
type = VarSet
trigger1 = stateno = [1000, 2999]
trigger1 = MoveHit = 1
fvar(16) = fvar(16) + 1

[State -2, Specials Scaling for Fireball]
type = VarSet
trigger1 = NumHelper(10) > 0
trigger1 = helper(10), MoveHit = 1
trigger2 = NumHelper(20) > 0
trigger2 = helper(20), MoveHit = 1
trigger3 = NumHelper(30) > 0
trigger3 = helper(30), MoveHit = 1
fvar(16) = fvar(16) + 1

; Super Damage scaling lawl
[State -2, Supers Scaling Reset]
type = VarSet
trigger1 = NumEnemy = 1
trigger1 = Enemy, movetype != H
trigger2 = NumEnemy = 2
trigger2 = ifelse((PlayerID(var(35)), alive), (PlayerID(var(35)), movetype != H), 1)
trigger2 = ifelse((PlayerID(var(36)), alive), (PlayerID(var(36)), movetype != H), 1)
fvar(17) = 0

[State -2, Supers Scaling]
type = VarSet
trigger1 = stateno = [3000, 4999]
trigger1 = MoveHit = 1
fvar(17) = fvar(17) + 1

[State -2, Supers Scaling for Fireball]
type = VarSet
trigger1 = NumHelper(40) > 0
trigger1 = helper(40), fvar(17) = 1
fvar(17) = fvar(17) + 1

;---------------------------------------------------------------------------
; RF/Shunpo Control
[State -2, RF New Round Reset]
type = VarSet
trigger1 = RoundState < 2
trigger2 = var(33) < 2
var(11) = 3

[State -2, Shunpo New Round Reset]
type = VarSet
trigger1 = RoundState < 2
trigger2 = var(33) < 2
var(13) = 3

[State -2, RF Recovery]
type = VarSet
triggerall = alive
trigger1 = var(10) < 600
trigger1 = var(11) < 3
var(10) = var(10) + 1

[State -2, RF Stock1]
type = VarSet
trigger1 = var(10) >= 600
trigger1 = var(11) < 3
var(11) = var(11) + 1

[State -2, RF Stock2]
type = VarSet
trigger1 = var(10) >= 600
var(10) = 0

[State -2, RF Stock3]
type = VarSet
trigger1 = var(11) = 3
trigger1 var(10) != 0
var(10) = 0

[State -2, Shunpo Recovery1]
type = VarSet
triggerall = alive
triggerall = fvar(14) < 600
triggerall = var(13) < var(11)
trigger1 = (StateNo = [0,199]) && (StateNo != [40,52]) && (StateNo != [120,140]) && (StateNo != 195)
;trigger2 = ((StateNo = [200,4999]) && (StateNo != [800,803]) && movetype = H)
trigger2 = movetype = H
fvar(14) = fvar(14) + 10

[State -2, Shunpo Recovery2]
type = VarSet
triggerall = alive
triggerall = fvar(14) < 600
triggerall = var(13) < var(11)
triggerall = movetype != H
trigger1 = (StateNo = [40,52]) || (StateNo = [120,140]) || ((StateNo = [200,4999]) && (StateNo != [800,803]) && movetype != H)
fvar(14) = fvar(14) + 1.5

[State -2, Shunpo Stock1]
type = VarSet
trigger1 = fvar(14) >= 600
trigger1 = var(13) < var(11)
var(13) = var(13) + 1

[State -2, Shunpo Stock2]
type = VarSet
trigger1 = fvar(14) >= 600
fvar(14) = 0

[State -2, Shunpo Stock3]
type = VarSet
trigger1 = var(13) >= var(11)
trigger1 = fvar(14) != 0
fvar(14) = 0

[State -2, Shunpo Stock4]
type = VarSet
trigger1 = var(13) > var(11)
var(13) = var(11)

;---------------------------------------------------------------------------
[State -2, Land Noise Reset]
type = VarSet
trigger1 = movetype = H
var(26) = 0

;---------------------------------------------------------------------------
[State -2, Normals Multiplier]
type = VarSet
trigger1 = 1
fvar(1) = (1 - (3 * (fvar(15)/32)))

[State -2, Specials Multiplier]
type = VarSet
trigger1 = 1
fvar(2) = (1 - (3 * (fvar(16)/200)))

[State -2, Supers Multiplier]
type = VarSet
trigger1 = 1
fvar(3) = (1 - (3 * (fvar(17)/396)))

[State -2, Normals Multiplier]
type = VarSet
trigger1 = fvar(15) > 8
fvar(1) = .25

[State -2, Specials Multiplier]
type = VarSet
trigger1 = fvar(16) > 8
fvar(2) = .25

[State -2, Supers Multiplier]
type = VarSet
trigger1 = fvar(17) > 8
fvar(3) = .25

;---------------------------------------------------------------------------
; Stop guarding with back
[State -2, Hold back guard off]
type = AssertSpecial
trigger1 = stateno != [191,192]
trigger1 = movetype != A
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

;---------------------------------------------------------------------------
; Stop guarding with back
[State -2, Hold back guard off]
type = AssertSpecial
trigger1 = stateno != [191,192]
trigger1 = movetype != A
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

;---------------------------------------------------------------------------
; No auto turn
[State -2, No auto turn]
type = AssertSpecial
trigger1 = 1
flag = noautoturn

;---------------------------------------------------------------------------
; Personal GameTime
[State -2, Time]
type = VarSet
trigger1 = ifelse((stateno = [3000,4999]), time > 24, 1)
var(33) = var(33) + 1
ignorehitpause = 1

;---------------------------------------------------------------------------
; FIRST ATTACK free stock
[State -2, Done]
type = VarSet
trigger1 = var(27) = 5
var(27) = 0
ignorehitpause = 1

[State -2, Half Stock for tie]
type = VarSet
triggerall = var(27) = 3
trigger1 = numpartner = 1
trigger1 = (partner, SelfAnimExist(66167100))
trigger1 = (partner, var(27) >= 3)
trigger2 = (enemy(0), SelfAnimExist(66167100))
trigger2 = (enemy(0), var(27) >= 3)
trigger3 = numenemy = 2
trigger3 = (enemy(1), SelfAnimExist(66167100))
trigger3 = (enemy(1), var(27) >= 3)
var(27) = 4
ignorehitpause = 1

[State -2, PowerAdd 1]
type = PowerAdd
trigger1 = var(27) = 3
trigger1 = var(27) := 5
value = 1000
ignorehitpause = 1

[State -2, PowerAdd 2]
type = PowerAdd
trigger1 = var(27) = 4
trigger1 = var(27) := 5
value = 500
ignorehitpause = 1

[State -2, Initialize]
type = VarSet
trigger1 = var(33) = 1
var(27) = 1
ignorehitpause = 1

[State -2, Check that everyone complies]
type = VarSet
triggerall = var(27) = 1
trigger1 = numpartner = 1
trigger1 = !(partner, SelfAnimExist(66167100))
trigger2 = !(enemy(0), SelfAnimExist(66167100))
trigger3 = numenemy = 2
trigger3 = !(enemy(1), SelfAnimExist(66167100))
var(27) = 0
ignorehitpause = 1

[State -2, Confirm]
type = VarSet
trigger1 = var(27) = 1
var(27) = 2
ignorehitpause = 1

[State -2, Turn off when someone else gets it]
type = VarSet
triggerall = var(27) = 2
trigger1 = numpartner = 1
trigger1 = (partner, SelfAnimExist(66167100))
trigger1 = (partner, var(27) >= 3)
trigger2 = (enemy(0), SelfAnimExist(66167100))
trigger2 = (enemy(0), var(27) >= 3)
trigger3 = numenemy = 2
trigger3 = (enemy(1), SelfAnimExist(66167100))
trigger3 = (enemy(1), var(27) >= 3)
var(27) = 0
ignorehitpause = 1

[State -2, Hit]
type = VarSet
triggerall = var(27) = 2
trigger1 = MoveHit
trigger2 = ProjHit = 1
trigger3 = NumHelper(10) > 0
trigger3 = helper(10), MoveHit
trigger4 = NumHelper(20) > 0
trigger4 = helper(20), MoveHit
trigger5 = NumHelper(30) > 0
trigger5 = helper(30), MoveHit
;trigger3 = helper(id), MoveHit ; Use one for each special helper (Checking super helpers would be pointless)
var(27) = 3
ignorehitpause = 1

;---------------------------------------------------------------------------
; Stuff
[State -2, Buddy Check]
type = VarSet
trigger1 = var(33) = 1
trigger1 = numpartner = 1
trigger1 = (partner, id) < id
var(12) = 1

[State -2, Buddy Check]
type = VarSet
trigger1 = var(12) = 1
trigger1 = partner, SelfAnimExist(66167100)
var(12) = 2

[State -2, Double Jump Land Reset]
type = VarSet
trigger1 = var(33) = 1
var(48) = 1 ; Double Jump

[State -2, Air Dash Land Reset]
type = VarSet
trigger1 = var(33) = 1
var(49) = 2 ; Air Dash

;---------------------------------------------------------------------------
; Clipboard
[State -2, Clipboard]
type = DisplayToClipboard
trigger1 = 1
text = "Normals:.%d Specials:.%d Supers:.%d (.999 is 1) %d %d" ; %d"
params = ifelse(fvar(1)=1,999,Floor(fvar(1)*1000)), ifelse(fvar(2)=1,999,Floor(fvar(2)*1000)), ifelse(fvar(3)=1,999,Floor(fvar(3)*1000)), var(27), var(33) ;var(30)


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;---------------------------------------------------------------------------
; Statedef -3 AI Stuff
; Kamek and Luchini appear to have been the first ones to use the IsHomeTeam AI
; activation concept.
; Feel free to move this controller to your character's intro state for slightly
; better efficiency.
[State -3, SetAI]
type = VarSet
triggerall = Alive && !IsHelper
triggerall = IsHomeTeam
trigger1 = TeamSide = 2
trigger2 = MatchNo > 1
var(58) = 1

[State -3, AI Helper - Compatibly Partnered Version]
type = Helper
trigger1 = !var(58) && !IsHelper
trigger1 = !NumHelper(9742)
trigger1 = Alive && RoundState = 2
trigger1 = NumPartner
trigger1 = Partner,SelfAnimExist(9741)
HelperType = normal
name = "AI Helper (Simul Version)"
ID = 9742
pos = 9999999,99999
StateNo = 9742
KeyCtrl = 1
PauseMoveTime = 2147483647
SuperMoveTime = 2147483647

; If you want to use the Guard mode, Dummy mode, Distance, or Button jam dummy
; control options in Training mode without activating the dummy's AI while
; working on the character, then all you need to do is temporarily disable
; this controller.  Or, if you want to permanently disable this controller in
; Training mode, then you could use the Training mode detection code available
; from my site ( http://www.mugenguild.net/~winane/ ), and then just add a
; "(var(59)&63)>30" triggerall to this controller.
; Alternatively, you can just set "Dummy control" to "Manual", press a P2 button
; to kill the AI helper, and then set dummy control back to "Cooperative".  (In
; fact, setting dummy control to manual isn't even necessary, if you press the
; P2 button prior to the first time you pause.)
[State -3, AI Helper]
type = Helper
triggerall = !var(58) && !IsHelper
triggerall = !NumHelper(9741)
triggerall = Alive && RoundState = 2
trigger1 = !NumPartner
trigger2 = !(Partner,SelfAnimExist(9741))
HelperType = normal
name = "AI Helper"
ID = 9741
pos = 9999999,99999
StateNo = 9741
KeyCtrl = 1
PauseMoveTime = 2147483647
SuperMoveTime = 2147483647

[State -3, TurnBackOnAI]
type = VarSet
trigger1 = var(58) = -2 && !IsHelper
trigger1 = Alive && RoundState = 2
var(58) = 1

; This method works somewhat in Linux Mugen version 2002.04.14,
; whereas the old humanly-impossible commands method does not.
; It is very important that this controller NOT be moved to State -2.
; Note that this part won't work nearly as well if AI.Cheat is turned off
; in mugen.cfg.
[State -3, XOR]
type = VarSet
triggerall = var(58)!=1 && !IsHelper
triggerall = !var(56)
triggerall = var(57) = GameTime-1
trigger1 = command = "a" ^^ command = "a2"
trigger2 = command = "b" ^^ command = "b2"
trigger3 = command = "c" ^^ command = "c2"
trigger4 = command = "x" ^^ command = "x2"
trigger5 = command = "y" ^^ command = "y2"
trigger6 = command = "z" ^^ command = "z2"
trigger7 = command = "start" ^^ command = "start2"
trigger8 = command = "holda" ^^ command = "holda2"
trigger9 = command = "holdb" ^^ command = "holdb2"
trigger10 = command = "holdc" ^^ command = "holdc2"
trigger11 = command = "holdx" ^^ command = "holdx2"
trigger12 = command = "holdy" ^^ command = "holdy2"
trigger13 = command = "holdz" ^^ command = "holdz2"
trigger14 = command = "holdstart" ^^ command = "holdstart2"
trigger15 = command = "holdfwd" ^^ command = "holdfwd2"
trigger16 = command = "holdback" ^^ command = "holdback2"
trigger17 = command = "holdup" ^^ command = "holdup2"
trigger18 = command = "holddown" ^^ command = "holddown2"
trigger19 = command = "recovery" ^^ command = "recovery2"
;Add more as desired. (See my notes in the CMD.)
var(58) = 1

; These next two controllers must be placed here, after the above XOR
; VarSet controller and before the below GameTime VarSet controller.
[State -3, fiXOR]
type = VarAdd
trigger1 = var(56) > 0 && !IsHelper
var(56) = -1

[State -3, fuXOR]
type = VarSet
trigger1 = var(57) < GameTime-1 && !IsHelper
var(56) = 31
IgnoreHitPause = 1

; It is very important that this controller NOT be moved to State -2, as putting
; it there would defeat the entire purpose of the controller, allowing the
; helper method or the XOR method to erroneously set the AI variable.
; And within State -3, don't put any ChangeState controllers before this
; controller, lest you unnecessarily delay your character's AI activation.
[State -3, GameTimeVar]
type = VarSet
trigger1 = !IsHelper
var(57) = GameTime
IgnoreHitPause = 1

; Within StateDef -3, none of your own AI-related code should come after the code
; provided here (and putting it before the code is also generally a bad idea).
; It's better to use State -1 (or, in special circumstances, State -2) instead.

;---------------------------------------------------------------------------
; Personal turn control with two opponents
[State -2, Hold back to turn]
type = null;Turn
trigger1 = numenemy = 2
trigger1 = (var(35) != 0) && (var(36) != 0)
trigger1 = (playerID(var(35)), alive) && (playerID(var(36)), alive)
trigger1 = statetype != A
trigger1 = (ctrl) && (command = "holdback")

;---------------------------------------------------------------------------
; Why
[State -3, Hold Back blocking lawl wut]
type = ChangeState
triggerall = !var(0)
triggerall = statetype != A
triggerall = InGuardDist
triggerall = var(16) >= 5
triggerall = ctrl
triggerall = command = "holdfwd"
trigger1 = ifelse(facing = -1, (pos x < playerID(var(35)), pos x), (pos x > playerID(var(35)), pos x))
trigger1 = numenemy = 1
trigger2 = numenemy = 2
trigger2 = (var(35) != 0) && (var(36) != 0)
trigger2 = ifelse(!(playerID(var(35)), alive), ifelse(facing = -1, (pos x < playerID(var(36)), pos x), (pos x > playerID(var(36)), pos x)), 0)
trigger3 = numenemy = 2
trigger3 = (var(35) != 0) && (var(36) != 0)
trigger3 = ifelse(!(playerID(var(36)), alive), ifelse(facing = -1, (pos x < playerID(var(35)), pos x), (pos x > playerID(var(35)), pos x)), 0)
value = 120

;---------------------------------------------------------------------------
;This controller plays a sound everytime the character lands from a jump.
[State -3, Landing Sound]
type = PlaySnd
triggerall = stateno != 1002
triggerall = stateno != 1202
triggerall = stateno != 1206
triggerall = stateno != [800,801]
triggerall = ifelse((stateno = 20 || (stateno = [100,105])), time = 0, 1)
trigger1 = statetype != A
trigger1 = var(26) = 1
;trigger2 = stateno = 851 ;Wake-up forward land
;trigger3 = stateno = 853 ;Wake-up forward land
value = 9,3

[State -3, Land Noise]
type = VarSet
triggerall = (var(26) = 0)
triggerall = movetype != H
trigger1 = stateno = 50
trigger2 = ((stateno = [120,150]) && (statetype = A))
trigger3 = ((stateno = [1300,1355]) && (statetype != S))
var(26) = 1

[State -3, Land Noise Reset]
type = VarSet
trigger1 = statetype != A
trigger2 = movetype = H
var(26) = 0

;---------------------------------------------------------------------------
;Face Slide Time
[State -3, Face Slide Timer Reset]
type = VarSet
trigger1 = stateno != [800,804]
var(22) = 0

;---------------------------------------------------------------------------
;Face Slide Super Armor
[State -3, Face Slide Super Armor Damage]
type = VarSet
trigger1 = stateno = [800,804]
trigger1 = gethitvar(damage) != 0
var(24) = gethitvar(damage)

[State -3, Face Slide Super Armor Damage Reset]
type = VarSet
trigger1 = stateno != [800,804]
var(24) = 0

[State -3, Face Slide Super Armor Time]
type = VarSet
trigger1 = var(25) = 0
trigger1 = stateno = [800,804]
var(25) = gethitvar(hitshaketime)

[State -3, Face Slide Super Armor Time Reset]
type = VarSet
trigger1 = stateno != [800,804]
var(25) = 0

;---------------------------------------------------------------------------
;RF Hit Check
[State -3, In RF State Reset]
type = VarSet
trigger1 = stateno != 1020
trigger1 = stateno != 1220
trigger1 = stateno != 1320
var(31) = 0

[State -3, In RF State]
type = VarSet
trigger1 = stateno = 1020
trigger2 = stateno = 1220
trigger3 = stateno = 1320
var(31) = 1

[State -3, Not RF'in]
type = Varset
trigger1 = (var(31) = 0)
var(29) = 0

[State -3, Not RF'in]
type = Varset
trigger1 = (var(31) = 0)
var(30) = 0

[State -3, RF'in]
type = VarSet
triggerall = var(35) != 0
triggerall = PlayerID(var(35)), SelfAnimExist(66167101)
trigger1 = var(31)
trigger1 = ifelse(stateno = 1020, abs((PlayerID(var(35)), pos x) - (pos x)) < 20, 0) ; last number should be attack distance
trigger2 = var(31)
trigger2 = ifelse(stateno = 1220, abs((PlayerID(var(35)), pos x) - (pos x)) < 30, 0) ; last number should be attack distance
trigger3 = var(31)
trigger3 = ifelse(stateno = 1320, abs((PlayerID(var(35)), pos x) - (pos x)) < 30, 0) ; last number should be attack distance
trigger3 = ifelse(facing = 1, (PlayerID(var(35)), pos x) >= (pos x), (PlayerID(var(35)), pos x) <= (pos x)) ; checks that opponent is in front, remove for things like Renji spin
trigger4 = NumHelper(30) > 0
trigger4 = helper(30), var(29)
var(29) = var(35)

[State -3, RF'in]
type = Varset
triggerall = numenemy > 1
triggerall = var(36) != 0
triggerall = PlayerID(var(36)), SelfAnimExist(66167101)
trigger1 = var(31)
trigger1 = ifelse(stateno = 1020, abs((PlayerID(var(36)), pos x) - (pos x)) < 20, 0) ; last number should be attack distance
trigger2 = var(31)
trigger2 = ifelse(stateno = 1220, abs((PlayerID(var(36)), pos x) - (pos x)) < 30, 0) ; last number should be attack distance
trigger3 = var(31)
trigger3 = ifelse(stateno = 1320, abs((PlayerID(var(36)), pos x) - (pos x)) < 30, 0) ; last number should be attack distance
trigger3 = ifelse(facing = 1, (PlayerID(var(36)), pos x) >= (pos x), (PlayerID(var(36)), pos x) <= (pos x)) ; checks that opponent is in front, remove for things like Renji spin
trigger4 = NumHelper(30) > 0
trigger4 = helper(30), var(30)
var(30) = var(36)

;---------------------------------------------------------------------------
;Tick Throw Preventer
[State -3, Tick Throw Target 1-1]
type = Varset
trigger1 = var(20) > 0
var(20) = var(20) - 1
ignorehitpause = 1

[State -3, Tick Throw Target 1-2]
type = Varset
trigger1 = var(35) != 0
trigger1 = PlayerID(var(35)), movetype = H
var(20) = 60
ignorehitpause = 1

[State -3, Tick Throw Target 2-1]
type = Varset
trigger1 = var(21) > 0
var(21) = var(21) - 1
ignorehitpause = 1

[State -3, Tick Throw Target 2-2]
type = Varset
trigger1 = numenemy = 2
trigger1 = var(36) != 0
trigger1 = PlayerID(var(36)), movetype = H
var(21) = 60
ignorehitpause = 1

[State -3, Tick Throw Self Preventer]
type = NotHitBy
trigger1 = var(15) > 0
value = , AT

[State -3, Tick Throw Self-1]
type = Varset
trigger1 = stateno != 850
trigger1 = stateno != 852
trigger1 = var(15) > 0
var(15) = var(15) - 1
ignorehitpause = 1

[State -3, Tick Throw Self-2]
type = Varset
trigger1 = movetype = H
var(15) = 60
ignorehitpause = 1

;---------------------------------------------------------------------------
;Corner Hit Pushback Idiocy
[State -3, Corner Hit Pushback Friction]
type = VarSet
triggerall = var(40) >= 3
triggerall = !(((stateno = 3000) && (time < 32)) || ((stateno = 3100) && (time < 51)))
trigger1 = fvar(4) != 0
fvar(4) = ifelse((fvar(4) - .375) < .5, 0, fvar(4) - .375)

[State -3, Pushback Delay Time Increment]
type = VarSet
trigger1 = var(38) = 0
var(40) = 0

[State -3, Pushback Delay Time Reset]
type = VarSet
trigger1 = var(40) >= 1
var(40) = var(40) + 1

[State -3, Corner Hit Pushback Enemy ID]
type = Varset
trigger1 = movecontact = 1
trigger1 = var(40) := 1
trigger1 = (stateno = [200,799]) || (stateno = [1000, 1099]) || (stateno = [1200, 1399]) ; Physical Attack States with normal pushback
trigger1 = NumTarget > 0
trigger1 = target, statetype != A
var(38) = target, ID
ignorehitpause = 1

[State -3, Corner Hit Pushback Enemy ID]
type = Varset
trigger1 = var(38) != 0
trigger1 = playerID(var(38)), HitOver
trigger1 = var(40) := 0
var(38) = 0
ignorehitpause = 1

[State -3, Corner Hit Pushback Velocity Reset]
type = Varset
trigger1 = var(38) = 0
fvar(4) = 0
ignorehitpause = 1

[State -3, Normal Corner Hit Pushback Velocity]
type = Varset
triggerall = stateno = [200,799]
trigger1 = var(38) != 0
trigger1 = movecontact = 1
trigger1 = (fvar(5) := facing) || 1
fvar(4) = ifelse((stateno = 220), 6, ifelse((stateno = 210) || (stateno = 410), 5, 4))
ignorehitpause = 1

[State -3, Special Corner Hit Pushback Velocity]
type = Varset
triggerall = (stateno = [1000, 1099]) || (stateno = [1200, 1399])
trigger1 = var(38) != 0
trigger1 = movecontact = 1
trigger1 = (fvar(5) := facing) || 1 ;This needs to be based on enemy position later ;Actually with turned pushback being messed up it's correct for now
fvar(4) = 4 ; I dunno what this should be, check later lol
ignorehitpause = 1

[State -3, Corner Hit Pushback]
type = PosAdd
triggerall = var(40) >= 3
triggerall = !(((stateno = 3000) && (time < 32)) || ((stateno = 3100) && (time < 51)))
triggerall = fvar(4) != 0
triggerall = (var(1) != 800) && (stateno != [800, 804])
triggerall = movetype != H
trigger1 = (PlayerID(var(38)), backedgebodydist = 0) || (PlayerID(var(38)), frontedgebodydist = 0);abs(playerID(var(38)), pos x) = 145
trigger1 = PlayerID(var(38)), statetype != A
x = -fvar(4) * ifelse(fvar(5) != facing, -1, 1)
