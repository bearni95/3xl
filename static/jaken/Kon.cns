trigger1 = command = "holdback"

[State 900, Standing HitDef]
type = HitDef
Trigger1 = (AnimElem = 1, >=0) && (AnimElem = 2, < 0)
trigger1 = ifelse(var(20) > 0, ifelse((enemynear, id = var(35)), 0, 1), 1)
trigger1 = ifelse(var(21) > 0, ifelse((enemynear, id = var(36)), 0, 1), 1)
;trigger1 = ifelse(var(15) != 0, ifelse((enemynear, id = var(15)), 0, 1), 1)
;trigger1 = ifelse(var(17) != 0, ifelse((enemynear, id = var(17)), 0, 1), 1)
trigger1 = statetype != A
;Trigger1 = ; Somehow figure out a way to prevent tick throwing.
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
p1sprpriority = 1     ;Draw p1's sprite in front of p2
                      ;p2's sprite priority is set to 0 by default
p1facing = 1
p2facing = 1          ;Force p2 to face character
p1stateno = 910       ;On success, character changes to state 910
p2stateno = 920       ;If hit, p2 changes to state 920 in character's cns
guard.dist = 0        ;This prevents p2 from going into a guard state if close
ground.velocity = 0, 0
fall = 0              ;Force p2 into falling down

[State 900, Air HitDef]
type = HitDef
Trigger1 = (AnimElem = 1, >=0) && (AnimElem = 2, < 0)
trigger1 = ifelse(var(20) > 0, ifelse((enemynear, id = var(35)), 0, 1), 1)
