; Spiked
; (a custom gethit state)
[Statedef 930]
type    = U
movetype= H
physics = N

[State 930, Invincible]
type = NotHitBy
trigger1 = 1
value = SCA

[State 930, Not in the Air lol]
type = SelfState
triggerall = time = 0
trigger1 = pos y >= 0
trigger2 = (!alive) && (statetype != A)
value = (5000 + (10 * (statetype = C)))

[State 930, StateTypeSet]
type = StateTypeSet
trigger1 = time = 0
statetype = A

[State 930, Anim]
type = ChangeAnim2
trigger1 = time = 0
value = ifelse(SelfAnimExist(5060), 5060, 5050)

[State 930, Turn]
type = Turn
trigger1 = time = 0
trigger1 = enemynear, facing = facing
ignorehitpause = 1

[State 930, Velocity]
type = VelSet
trigger1 = HitShakeOver
x = -8
y = 12

[State 930, Pass Through]
type = PlayerPush
trigger1 = 1
value = 0

[State 930, Hit Floor]
type = ChangeState
trigger1 = pos y >= 0
value = 931

;---------------------------------------------------------------------------
; HIT_BOUNCE (hit ground)
[Statedef 931]
type    = L
movetype= H
physics = N

[State 931, Sound]
type = PlaySnd
trigger1 = time = 0
trigger1 = SelfAnimExist(66167100)
value = 10,14
channel = 0

[State 931, Invincible]
type = NotHitBy
trigger1 = 1
value = SCA

[State 931, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 931, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

[State 931, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 931, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 931, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 931, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 931, 6]
type = VelSet
trigger1 = Time = 0
x = -4

[State 931, 9]
type = HitFallDamage
trigger1 = Time = 3

[State 931, 11]
type = PosFreeze
trigger1 = 1

[State 931, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 932

[State 931, 13]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20

