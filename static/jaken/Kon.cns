type = VarSet
trigger1 = var(1):=1
var(5) = !var(7)

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = Anim = 5
;trigger1 = prevstateno = 105
;trigger1 = abs(vel x) < 2
;trigger2 = Time = 4
x = 0

[State 0, Turn animation: One Opponent]
type = ChangeAnim
triggerall = (command != "holdfwd" && command != "holdback")
trigger1 = numenemy = 1
trigger1 = ifelse((facing = -1), pos x < (playerID(var(35)), pos x), 1)
trigger1 = ifelse((facing = 1), pos x > (playerID(var(35)), pos x), 1)
value = 5

[State 0, Turn animation: Two Opponents-One Dead]
type = ChangeAnim
triggerall = (command != "holdfwd" && command != "holdback")
triggerall = numenemy = 2
triggerall = (var(35) != 0) && (var(36) != 0)
triggerall = (playerID(var(35)), alive) || (playerID(var(36)), alive)
trigger1 = !(playerID(var(35)), alive)
trigger1 = ifelse((facing = -1), pos x < (playerID(var(36)), pos x), 1)
trigger1 = ifelse((facing = 1), pos x > (playerID(var(36)), pos x), 1)
trigger2 = !(playerID(var(36)), alive)
trigger2 = ifelse((facing = -1), pos x < (playerID(var(35)), pos x), 1)
trigger2 = ifelse((facing = 1), pos x > (playerID(var(35)), pos x), 1)
value = 5

[State 0, Auto turn: One Opponent]
type = Turn
triggerall = (command != "holdfwd" && command != "holdback")
trigger1 = numenemy = 1
trigger1 = ifelse((facing = -1), pos x < (playerID(var(35)), pos x), 1)
trigger1 = ifelse((facing = 1), pos x > (playerID(var(35)), pos x), 1)

[State 0, Auto turn: Two Opponents-One Dead]
type = Turn
triggerall = (command != "holdfwd" && command != "holdback")
triggerall = numenemy = 2
triggerall = (var(35) != 0) && (var(36) != 0)
triggerall = (playerID(var(35)), alive) || (playerID(var(36)), alive)
trigger1 = !(playerID(var(35)), alive)
trigger1 = ifelse((facing = -1), pos x < (playerID(var(36)), pos x), 1)
trigger1 = ifelse((facing = 1), pos x > (playerID(var(36)), pos x), 1)
trigger2 = !(playerID(var(36)), alive)
trigger2 = ifelse((facing = -1), pos x < (playerID(var(35)), pos x), 1)
trigger2 = ifelse((facing = 1), pos x > (playerID(var(35)), pos x), 1)

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

