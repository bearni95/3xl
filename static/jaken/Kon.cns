;fvar(33) Orb 2 ID
;fvar(34) Laser Center
;fvar(35) Laser Mode (0 = full length, 1 = has a target, 2 = resized)
;fvar(36) Orb 1 reflection ID
;fvar(37) Orb 2 reflection ID
;Ikkaku:
;fvar(25) Bankao Rune
;fvar(26) Super Armor damage
;Ururururururu:
;fvar(25) to fvar(36) Cannon charge variables
;  var(0) AI: The simplifier variable, optional but helpful
;  var(1) Combo Condition
;  var(2) Special A Combo Condition
;  var(3) Special B Combo Condition
;  var(4) Special C Combo Condition
;  var(5) Special D Combo Condition
;  var(6) Special E Combo Condition
;  var(7) Super A Combo Condition
;  var(8) Super B Combo Condition
;  var(9) Super C Combo Condition
; var(10) RF Refill
; var(11) RF Stock
; var(12) I have a buddy, and his id < mine
; var(13) Shunpo Stock
; var(14) Damage Cancel Check
; var(15) Tick Throw preventer, self
; var(16) Hold back guarding on? Fine.
; var(17)
; var(18)
; var(19) Intro/Taunt/Win Randomize, or other randomizer
; var(20) Tick Throw preventer, opponent 1
; var(21) Tick Throw preventer, opponent 2
; var(22) Shunpo Time
; var(23) Face Slide Stateno/Shunpo direction
; var(24) Super Armor Damage Take
; var(25) Face Slide Super Armor Time
; var(26) Land Noise plz
; var(27) FIRST ATTACK
; var(28) In Shunpo
; var(29) RF hit 1
; var(30) RF hit 2
; var(31) In RF state
; var(32) Hitspark/Guardspark Thing XXX
; var(33) Personal GameTime
; var(34) Special timer (as needed)
; var(35) Enemy 1 ID
; var(36) Enemy 2 ID
; var(37) Walk backwards to shunpo fix XXX
; var(38) Corner hit pushback enemy ID
; var(39) Special Targetting
; var(40) Cornerhit pushback delay
; var(41) Bankai "time" / Fireball Self Erase
; var(42) BANKAIZ ON
; var(43) Bankai State
; var(44) Bankai Super Armor Counter
; var(45) Shortcut 1 Limiter
; var(46) Shortcut 2 Limiter
; var(47) Shortcut 3 Limiter
; var(48) Double Jump Land Reset
; var(49) Air Dash Land Reset
; var(50) Special A Land Reset
; var(51) Special B Lend Reset
; var(52) Special C Land Reset
; var(53) Special D Land Reset
; var(54) Special E Land Reset
; var(55) Super A Land Reset
; var(56) AI: Used by the XOR-ed commands method to detect recent custom states
; var(57) AI: The GameTime variable, required by the helper and XOR methods
; var(58) AI: The primary AI variable
; var(59)
;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; Win pose
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191

;---------------------------------------------------------------------------
; Introduction, Pre-Intro
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, Why do you want hold back guarding]
type = VarSet
trigger1 = command = "back"
var(16) = var(16) + 1

[State 191, Random]
type = VarRandom
trigger1 = time = 0
v = 19
range = 0, 5

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = RoundState != 0
value = 192

;---------------------------------------------------------------------------
; Standing Light
[StateDef 200]
anim = 200
ctrl = 0
type = S
movetype = A
physics = S
juggle = 0
sprpriority = 2

[State 200, Auto turn: One Opponent]
type = Turn
triggerall = time <= 1
triggerall = prevstateno != [200,799]
trigger1 = numenemy = 1
trigger1 = ifelse((facing = -1), pos x < (playerID(var(35)), pos x), 1)
trigger1 = ifelse((facing = 1), pos x > (playerID(var(35)), pos x), 1)

[State 200, Auto turn: Two Opponents-One Dead]
type = Turn
triggerall = time <= 1
triggerall = prevstateno != [200,799]
triggerall = numenemy = 2
triggerall = (var(35) != 0) && (var(36) != 0)
trigger1 = !(playerID(var(35)), alive)
trigger1 = ifelse((facing = -1), pos x < (playerID(var(36)), pos x), 1)
trigger1 = ifelse((facing = 1), pos x > (playerID(var(36)), pos x), 1)
trigger2 = !(playerID(var(36)), alive)
trigger2 = ifelse((facing = -1), pos x < (playerID(var(35)), pos x), 1)
trigger2 = ifelse((facing = 1), pos x > (playerID(var(35)), pos x), 1)

[State 200, Turn]
type = Turn
triggerall = time <= 1
triggerall = prevstateno != [200,799]
triggerall = numenemy = 2
triggerall = (playerID(var(35)), alive)
triggerall = (playerID(var(36)), alive)
trigger1 = time = 0
trigger1 = command = "holdback"
;trigger2 = facing = 1
;trigger2 = (playerID(var(35)), pos x) < pos x
;trigger2 = (playerID(var(36)), pos x) < pos x
;trigger3 = facing = -1
;trigger3 = (playerID(var(35)), pos x) > pos x
;trigger3 = (playerID(var(36)), pos x) > pos x

[State 200, Sound]
type = PlaySnd
trigger1 = time = 6
value = 2,0
channel = 0
volume = 75

[State 200, Sound2]
type = PlaySnd
trigger1 = animelem = 2
value = 3,0

[State 200, HitDef]
type = HitDef
trigger1 = Time = 0
attr = S, NA
hitflag = MAF
guardflag = MA
animtype = Light
damage = Floor(ifelse(fvar(15) < 8, 12 * (1 - (3 * (fvar(15)/32))), 12 / 4))
pausetime = 7,7
sparkno = S974
guard.sparkno = S973
sparkxy = -10, -20
hitsound = S3,3
guardsound = S10,8
ground.type = High
ground.slidetime = 20
ground.hittime  = 20
guard.dist = 25
ground.velocity = -4
air.velocity = 0,-4
air.hittime = 20
guard.velocity = -6
airguard.velocity = 0,0
ground.cornerpush.veloff = 0; -8
air.cornerpush.veloff = 0
guard.cornerpush.veloff = 0; -8
airguard.cornerpush.veloff = 0
getpower = Floor(ifelse(fvar(15) < 8, 60 * (1 - (3 * (fvar(15)/32))), 60 / 4)), 0
givepower = Floor(ifelse(fvar(15) < 8, 30 * (1 - (3 * (fvar(15)/32))), 30 / 4)), 0
	
[State 200, Combo Into New Move]
type = ChangeState
triggerall = !var(0)
triggerall = AnimElemTime(2) >= 2 ; for "AnimElemTime(x) >= 2", x = first element with a CLSN1 
trigger1 = (var(1) = [200,220]) || (var(1) = [400,420]) || (var(1) = [800,801])
value = var(1)    

[State 200, Stand State]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

