[Data]
life = 1000
attack = 100
defence = 47
fall.defence_up = 0
liedown.time = 30 ; This doesn't do anything since the change states are defined later, must be > 10
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
volume = 1000
IntPersistIndex = 60
FloatPersistIndex = 40

; There are some things in this group that you may want to change.
[Size]
; The next two parameters are the X and Y scale factors of your character's
; sprites. You can leave them at 1 each to keep your sprites at a normal
; size.
xscale = 1
yscale = 1
; Make sure you adjust the width settings below to suit your character.
; These affect how close another character can get to yours. Adjust these
; values and press Ctrl-C in-game. Look at the bar the feet of the
; characters.
ground.back = 10          ;Player width (back, ground)
ground.front = 10         ;Player width (front, ground)
air.back = 10             ;Player width (back, air)
air.front = 10            ;Player width (front, air)
; This is generally fine at 60. Don't make it too big, or other
; characters will have trouble jumping over yours.
height = 26               ;Height of player (for opponent to jump over)
; You can leave the next 3 unchanged.
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
; You can set these accordingly if your character is tall or short.
; Otherwise, these default values should be fine.
head.pos = 0, -25        ;Approximate position of head
mid.pos = 0, -12         ;Approximate position of midsection
; The next 2 parameters don't need to be changed.
shadowoffset = 0
draw.offset = 0,0

; These are the velocities used in various common states that all
; characters have. Adjust these to suit your character.
[Velocity]
walk.fwd  = 1.5           ;Walk forward
walk.back = -1.5          ;Walk backward
run.fwd  = 4, 0         ;Run forward (x, y) (y should be 0)
run.back = -4,0      ;Hop backward (x, y)
jump.neu = 0,-10         ;Neutral jumping velocity (x, y)
jump.back = -3         ;Jump back Speed (x, y)
jump.fwd = 3            ;Jump forward Speed (x, y)
runjump.back = -4,-10 ;Running jump speeds (opt)
runjump.fwd = 4,-10      ;.
airjump.neu = 0,-10      ;.
airjump.back = -3      ;Air jump speeds (opt)
airjump.fwd = 3         ;.

; These are miscellaneous variables used for movement. Set
; accordingly.
[Movement]
airjump.num = 1           ;Number of air jumps allowed (opt)
airjump.height = 0       ;Minimum distance from ground before you
                          ;can air jump (opt)
yaccel = .34375           ;Vertical acceleration
stand.friction = .89      ;Friction coefficient when standing
crouch.friction = .89     ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Variable usage:
; fvar(1) Normals Damage Scaling  | Maybe use
; fvar(2) Specials Damage Scaling | fvar(5 to 7)
; fvar(3) Supers Damage Scaling   | for enemy 2
; fvar(4) Corner hit pushback
; fvar(5) Corner pushback initial direction
