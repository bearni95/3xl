; Hit by Launcher 1
[Statedef 980]
type    = S
movetype= H
physics = N
velset = 0,0

[State 980, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(5009 + GetHitVar(animtype) < 5010, 5010, 5009 + GetHitVar(animtype))

[State 980, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 10
value = 5000 + GetHitVar(animtype)

[State 980, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 980, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 980, 7]
type = ChangeState
trigger1 = HitShakeOver
value = 981

[State 980, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 980, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 980, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

