;In case attacker loses binding on player for any reason, this controller
;guarantees that the player will never get stuck in this thrown state.
[State 920, 2]
type = SelfState
trigger1 = !gethitvar(isbound)
value = 5050

;---------------------------------------------------------------------------
;Thrown by Normal Throw - thrown into the air
[Statedef 921]
type    = A
movetype= H
physics = N
sprpriority = 1
;velset = -10,0

[State 921, VelSet]
type = VelSet
trigger1 = time = 0
x = -10
y = 0

[State 921, Damage Cancel Check 1]
type = VarSet
trigger1 = SelfAnimExist(66167100)
var(14) = 1

[State 921, Damage Cancel Check 2]
type = VarSet
triggerall = SelfAnimExist(66167100)
trigger1 = (NumEnemy = 1) && ((playerID(var(35)), HitDefAttr = SCA, HA, HT, HP) || (playerID(var(35)), stateno = [3000,4999]))
trigger2 = (NumEnemy > 1)
trigger2 = var(36) != 0
trigger2 = ((playerID(var(35)), HitDefAttr = SCA, HA, HT, HP) || (playerID(var(35)), stateno = [3000,4999]))
trigger2 = ((playerID(var(36)), HitDefAttr = SCA, HA, HT, HP) || (playerID(var(36)), stateno = [3000,4999]))
var(14) = 0

[State 921, Damage Cancel]
type = ChangeState
triggerall = ifelse(SelfAnimExist(74140108), var(58)<1, 1)
trigger1 = SelfAnimExist(66167100)
trigger1 = command = "DC"
trigger1 = power >= 1000
trigger1 = alive
trigger1 = movetype = H
trigger1 = var(14) = 1
value = 950

[State 921, Go to stand state if hit]
type = HitOverride
trigger1 = 1
time = 1
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
value = 5000

[State 921, 1]
type = ChangeAnim
triggerall = SelfAnimExist(66167100)
trigger1 = Time = 0
trigger1 = SelfAnimExist(5900)
value = 5902

[State 921, 1]
type = ChangeAnim
triggerall = !SelfAnimExist(66167100)
trigger1 = Time = 0
trigger1 = SelfAnimExist(5900)
value = 5900

[State 921, 2]
type = ChangeAnim2 ;2
trigger1 = Time = 0
trigger1 = !SelfAnimExist(5900)
value = 5030

[State 921, HitDef1]
type = HitDef
triggerall = SelfAnimExist(66167100)
trigger1 = Time = 0
trigger1 = SelfAnimExist(5900)
attr = S, SA
damage = 24
guardflag = MA
pausetime = 7,7
sparkno = S974
guard.sparkno = S973
sparkxy = -14, 0
hitsound = S3,7
guardsound = S10,8
affectteam = F
animtype = Hard
ground.type = High
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = 1, -2
air.velocity = 1, -2
yaccel = .25
air.hittime = 20
guard.velocity = -6
airguard.velocity = 0,0
ground.cornerpush.veloff = -0
air.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
getpower = 120, 0
givepower = 0, 0
fall = 0
fall.recover = 0

[State 921, Target State]
type = TargetState
triggerall = SelfAnimExist(66167100)
trigger1 = MoveHit = 1
trigger1 = numtarget > 0
value = 974

[State 921, Target State]
type = ChangeState
triggerall = SelfAnimExist(66167100)
trigger1 = MoveHit = 1
value = 974

[State 921, Pass Through]
type = PlayerPush
trigger1 = 1
value = 0

[State 921, ScreenBound]
type = ScreenBound
trigger1 = numenemy = 1
value = 0
movecamera = ifelse((enemy(0), stateno = 101 || enemy(0), stateno = 910), 1, !((enemy(0), pos x - pos x < -250) || (pos x - enemy(0), pos x < -250))),1

[State 921, ScreenBound]
type = ScreenBound
trigger1 = numenemy = 2
value = 0
movecamera = ifelse(((enemy(0), stateno = 101 || enemy(0), stateno = 910) || (enemy(1), stateno = 101 || enemy(1), stateno = 910)), 0, 1),1

[State 921, Hit wall]
type = ChangeState
trigger1 = pos x <= (-160 + Const(size.ground.back)) ;BackEdgeBodyDist <= 5.5
trigger2 = pos x >= (160 - Const(size.ground.back)) ;FrontEdgeBodyDist <= 5.5
trigger3 = P2BodyDist x >= 480
;trigger3 = numenemy = 1
;trigger3 = ((enemy(0), pos x - pos x < -290) || (pos x - enemy(0), pos x < -290))
;trigger4 = numenemy = 2
;trigger4 = ((enemy(0), pos x - pos x < -290) || (pos x - enemy(0), pos x < -290)) || ((enemy(1), pos x - pos x < -290) || (pos x - enemy(1), pos x < -290))
value = 922

;---------------------------------------------------------------------------
;Thrown by Normal Throw - thrown into the air
[Statedef 922]
type    = A
movetype= H
physics = N
velset = 0,0

[State 922, Go to stand state if hit]
type = HitOverride
trigger1 = 1
time = 1
attr = SCA
value = 5000

[State 922, Pass Through]
type = PlayerPush
trigger1 = 1
value = 0

[State 922, ScreenBound]
type = ScreenBound
trigger1 = numenemy = 1
value = 0
movecamera = ifelse((enemy(0), stateno = 101 || enemy(0), stateno = 910), 1, !((enemy(0), pos x - pos x < -250) || (pos x - enemy(0), pos x < -250))),1

[State 922, ScreenBound]
type = ScreenBound
trigger1 = numenemy = 2
value = 0
movecamera = ifelse(((enemy(0), stateno = 101 || enemy(0), stateno = 910) || (enemy(1), stateno = 101 || enemy(1), stateno = 910)), 0, 1),1

[State 922, Hit wall]
type = ChangeState
trigger1 = time = 1
value = 923

;---------------------------------------------------------------------------
; Thrown by Normal Throw - bounce off wall
; (a custom gethit state)
[Statedef 923]
type    = A
movetype= H
physics = N

[State 923, ScreenBound]
type = ScreenBound
trigger1 = numenemy = 1
value = 0
movecamera = ifelse((enemy(0), stateno = 101 || enemy(0), stateno = 910), 1, !((enemy(0), pos x - pos x < -250) || (pos x - enemy(0), pos x < -250))),1

[State 923, ScreenBound]
type = ScreenBound
trigger1 = numenemy = 2
value = 0
movecamera = ifelse(((enemy(0), stateno = 101 || enemy(0), stateno = 910) || (enemy(1), stateno = 101 || enemy(1), stateno = 910)), 0, 1),1

[State 923, Gravity]
type = VelAdd
trigger1 = 1
y = .1875

[State 923, Vel Y]
type = VelSet
trigger1 = Time = 0
y = -2

[State 923, Vel X]
type = VelSet
trigger1 = Time = 0
x = 3

[State 923, Anim 5050] ;Self falling animation
type = ChangeAnim
trigger1 = Time = 0
trigger1 = !SelfAnimExist(5052) && !SelfAnimExist(5901)
value = 5050

[State 923, Anim 5052] ;Self falling animation (diagup type)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5052) && !SelfAnimExist(5901)
value = 5052

[State 923, Anim 5052] ;Self falling animation (diagup type)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5901)
value = 5901

[State 923, OTG]
type = StateTypeSet
trigger1 = (Vel y > 0) && (Pos y >= 0)
statetype = S

[State 923, Vel Y]
type = PosSet
trigger1 = (Vel y > 0) && (Pos y >= 0)
y = 0

[State 923, Vel Y]
type = VelSet
trigger1 = (Vel y > 0) && (Pos y >= 0)
y = 0

[State 923, ChangeState]
type = ChangeState
trigger1 = statetype = S
value = 924

