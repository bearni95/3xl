{
	"name": "@3xl/data",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Character registry module + JSON definitions and movesets. Written by @3xl/mugen, consumed by @3xl/frontend.",
	"main": "./index.ts",
	"types": "./index.ts",
	"exports": {
		".": "./index.ts",
		"./public/*": "./public/*"
	},
	"files": [
		"index.ts",
		"registry.generated.ts",
		"public"
	],
	"scripts": {
		"generate:geo": "node --max-old-space-size=8192 generate-geo.js",
		"generate:shows": "node generate-shows.js"
	},
	"devDependencies": {
		"topojson-client": "^3.1.0",
		"topojson-server": "^3.0.1"
	}
}
