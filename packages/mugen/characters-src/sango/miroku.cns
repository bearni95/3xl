;Miroku Assist Helper
[StateDef 1402]
type = A
movetype = I
physics = N
anim = 1400
velset = 10,-10
sprpriority = 3

[State 1402, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay
ignorehitpause = 1

[State 1402, BGPalFX]
type = BGPalFX
trigger1 = 1
time = 1
add = -256+floor(cos(time*.029)*256), -256+floor(cos(time*.029)*256), -256+floor(cos(time*.029)*256)
mul = 256,256,256
sinadd = 0,0,0,10
invertall = 0
color = 256
ignorehitpause = 1
;persistent =

[State 1402, PlaySnd]
type = PlaySnd
trigger1 = !time
value = 1400,1

[State 1402, Gravity]
type = Gravity
trigger1 = pos y < 0

[State 1402, VelSet]
type = VelSet
trigger1 = pos y > 0
y = 0
x = 0

[State 1402, PosSet]
type = PosSet
trigger1 = pos y > 0
y = 0

[State 1402, ChangeState]
type = ChangeState
trigger1 = pos y = 0
value = 1403

