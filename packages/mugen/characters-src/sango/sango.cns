damage    = 0
guardflag = MA
pausetime = 10,10
sparkno = S20005
guard.sparkno = S20001
sparkxy = -10,-60
hitsound   = S210, 2
guardsound = S200, 3
ground.type = Low
ground.slidetime = 12
ground.hittime  = 20
ground.velocity = -6
air.velocity = -2.2,-3.2
air.fall = 1
p1stateno = 1401
p2stateno = 902

[State 1400, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Miroku Assist (Success)
[StateDef 1401]
type = S
movetype = I
physics = S

[State 1401, PlaySnd]
type = PlaySnd
trigger1 = !time
value = 40,0
channel = 0

[State 1401, SuperPause]
type = SuperPause
trigger1 = !time
time = 60
anim = -1
sound = S1400,0
pos = 0,0
move = 0
movetime = 0
darken = 1
p2defmul = 0
poweradd = -500
unhittable = 1
;ignorehitpause =
;persistent =

[State 1401, Helper]
type = Helper
trigger1 = time=1
helpertype = normal ;player
name = "MIROKU"
ID = 1402
stateno = 1402
pos = -400,-50
postype = back    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 0;999999
pausemovetime = 0;999999

[State 1401, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[StateDef -2]

[State -2, Jump Start Sound]
type = PlaySnd
trigger1 = stateno=40 && time=1
value = 40,0

[State -2, Jump Land Dust]
type = Explod
trigger1 = stateno=52 && time=1
anim = 11400
ID = 11400
removetime = -2
ontop = 0
ownpal = 1
scale = .5,.5
removeongethit = 0

[State -2, Damage Dampener]; Scaling in action
type= attackmulset
trigger1= numenemy
value= ifelse(enemynear, gethitvar(hitcount) = 0, 1, ifelse(enemynear, gethitvar(hitcount) = 1, 0.9, 0.8**enemynear, gethitvar(hitcount)))
ignorehitpause= 1

[State -2, Damage Dampener]; Full damage
type= attackmulset
trigger1= numenemy
trigger1= enemynear,movetype!=H || (enemynear,stateno=[120,155])
value= 1.0
ignorehitpause= 1

[State -2, PlaySnd]
type = PlaySnd
trigger1 = enemynear(0),movehit && HitOver=0 && time%100=0
value = 5000,0
ignorehitpause = 1
pausemovetime = 99999

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "P2BDX: %d | P2BDY: %d\nSango by Alexei Roschak (kenshinx0)"
params = P2BodyDist X, P2BodyDist Y
