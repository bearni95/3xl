ground.front = 16    
air.back = 12        
air.front = 12       
height = 60	     
attack.dist = 160    
proj.attack.dist = 90 
proj.doscale = 0       
head.pos = -5, -90   
mid.pos = -5, -60    
shadowoffset = 0     
draw.offset = 0,0    

[Velocity]
walk.fwd  = 1.8      
walk.back = -1.5    
run.fwd  = 6, 0    
run.back = -4.5,-3.8 
jump.neu = 0,-9    
jump.back = -2.55    
jump.fwd = 2.7       
runjump.back = -2.55,-8.1 
runjump.fwd = 4,-8.1      
airjump.neu = 0,-12      
airjump.back = -2.7      
airjump.fwd = 2.5         

[Movement]
airjump.num = 1      
airjump.height = 35  
yaccel = .44         
stand.friction = .85  
crouch.friction = .82 

[Quotes]
;normal win quotes
victory1 = "(Shinji) If you had piloted an EVA, then you would've won this fight."
victory2 = "(Shinji) LOL! You're lame even for my own standards!"
victory3 = "(Shinji) You were more focused on making a ruckus than actually targeting me."
victory4 = "(Shinji) Thank you all."
victory5 = "(Shinji) Misato is going to be so pissed at me for disobeying NERV's orders!"
victory6 = "(Shinji) I better go to school."
victory7 = "(Shinji) Phew! That was close! I almost got killed there..."
victory8 = "(Shinji) Go to hell, you goddamn vermin!"


