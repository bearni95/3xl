poweradd = 10                ;パワーゲージの増加量を設定
sprpriority = 2              ;画像表示優先度　数値が多いと手前に、少ないと奥に優先されます

[State 220, ヒット定義]
type = HitDef                ;攻撃ヒット定義（Hit Definition）のステートコントローラ
trigger1 = Time = 0     ;攻撃判定ボックスがあればアニメーション３番目のコマで適用されます
attr = S, SA                 ;攻撃属性: これは Standing, Normal Attack（立ち通常攻撃）、重要項目です
damage = 70, 7               ;相手に与えるダメージ（ヒットした時,ガードされた時）
animtype = Hard             ;当たった時の相手のアニメの種類: Light, Medium, Hard, Back, Up, DiagUp
guardflag = MA               ;相手が立ち・しゃがみ・空中どのガードが出来るかを決めます（MiddleAir 全部ガードされます）
hitflag = MAF                ;相手がどの状態の時で攻撃を当てられるかを決めます（MiddleAirFall）
priority = 4, Hit            ;攻撃優先度: 0 (最低) 7 (最高) 4がデフォルト・種類はHit/Miss/Dodge (デフォルト：Hit)
pausetime = 0, 24             ;攻撃を当てた時の自分と相手の硬直時間（自分,相手）
sparkno = 1                  ;ヒットスパーク (デフォルト：[Data]の項目で設定したモノが適用される) ★３
guard.sparkno = 40           ;ガードスパーク (デフォルト：[Data]の項目で設定したモノが適用される) ★３
sparkxy = -10, -60           ;ヒットスパークの位置（Ｘ軸,Ｙ軸）
hitsound = s0, 0              ;ヒットサウンド（Sを付けると自分のSNDファイルから）
guardsound = 6, 0            ;ガードサウンド（Sを付けないとMUGENデフォルトから）
ground.type = High           ;当たった時の地上の相手のアニメの属性　High：頭、体, Low：足, Trip：足払い
ground.slidetime = 5         ;当たった時の地上の相手がのけぞる時間
ground.hittime  = 24         ;当たった時の地上の相手のやられ状態の時間
ground.velocity = -6,-5       ;当たった時の地上の相手の初速度（Ｘ軸,Ｙ軸）
airguard.velocity = -1.9,-.8 ;ガードされた時の空中の相手の初速度 (デフォルト：(air.xvel*1.5, air.yvel/2))
air.type = High              ;当たった時の空中の相手のアニメの属性: High, Low, Trip (デフォルト：ground.typeと同じになる)
air.velocity = -5,-4       ;当たった時の空中の相手の初速度（Ｘ軸,Ｙ軸）
air.hittime = 24             ;当たった時の空中の相手のやられ状態の時間
p2facing = 1
fall = 1
fall.recovertime = 50 ;相手が吹っ飛び中に空中受け身が可能になるまでの時間（つまりその間は空中受け身不可）
yaccel = .4 ;ヒット時相手吹っ飛びのＹ軸方向に速度を加える

[State 1000, 0]
type = PosAdd
trigger1 = time = 0
x = -20

[State 220, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = 0, 0

[State 220, ステート変更]
type = ChangeState
trigger1 = movehit = 1 ;アニメーション時間が０、つまりアニメが終了した時に有効になります。
value = 2200

[State 220, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0 ;アニメーション時間が０、つまりアニメが終了した時に有効になります。
value = 0
ctrl = 1 ;★４

;★４：ステートナンバー０は通常立ちステートなので、特殊なものでない限り
;　　　攻撃が終わればコントロール可能にしておく必要があります。

[Statedef 2200]
type     = S                 ;キャラの状態を指定
                             ;S=立ち　C=しゃがみ　A=空中　L=倒れている　U=前のステートの状態を引き継ぐ
movetype = A                 ;キャラの行動内容を指定 I=何もしない　A=攻撃している　H=攻撃を食らっている
physics  = S                 ;キャラの物理的な体勢
                             ;S=立ち　C=しゃがみ　A=空中　N=重力や摩擦の影響を受けない　U=前のステートの体勢を引き継ぐ
velset   = 0,0               ;移動初速度の設定（このステートでは0,0なので移動せず止まります）
ctrl     = 0                 ;コントロールの可否（0=キー操作不可・1=キー操作可能）
anim     = 2200               ;airファイルの[Begin Action 200]のアニメを使っています
sprpriority = 2              ;画像表示優先度　数値が多いと手前に、少ないと奥に優先されます

[State 2005, 走る]
type = VelSet
trigger1 = Time <= 16
X = 2;const(velocity.run.fwd.x)

[State 210, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1000, 11

[State 220, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0 ;アニメーション時間が０、つまりアニメが終了した時に有効になります。
value = 0
ctrl = 1 ;★４

;-----------------------------------------------------
; ジャマイカの情熱
[Statedef 230]
type     = S                 ;キャラの状態を指定
                             ;S=立ち　C=しゃがみ　A=空中　L=倒れている　U=前のステートの状態を引き継ぐ
movetype = A                 ;キャラの行動内容を指定 I=何もしない　A=攻撃している　H=攻撃を食らっている
physics  = S                 ;キャラの物理的な体勢
                             ;S=立ち　C=しゃがみ　A=空中　N=重力や摩擦の影響を受けない　U=前のステートの体勢を引き継ぐ
juggle   = 1                 ;攻撃を当てた時に溜まるジャグルポイントの設定
velset   = 0,0               ;移動初速度の設定（このステートでは0,0なので移動せず止まります）
ctrl     = 0                 ;コントロールの可否（0=キー操作不可・1=キー操作可能）
anim     = 230               ;airファイルの[Begin Action 200]のアニメを使っています
poweradd = 10                ;パワーゲージの増加量を設定
sprpriority = 2              ;画像表示優先度　数値が多いと手前に、少ないと奥に優先されます

[State 200, ヒット定義]
type = HitDef                ;攻撃ヒット定義（Hit Definition）のステートコントローラ
trigger1 = Time = 0
attr = S, SA                 ;攻撃属性: これは Standing, Normal Attack（立ち通常攻撃）、重要項目です
damage = 40, 4               ;相手に与えるダメージ（ヒットした時,ガードされた時）
animtype = hard             ;当たった時の相手のアニメの種類: Light, Medium, Hard, Back, Up, DiagUp
guardflag = MA               ;相手が立ち・しゃがみ・空中どのガードが出来るかを決めます（MiddleAir 全部ガードされます）
hitflag = MAF                ;相手がどの状態の時で攻撃を当てられるかを決めます（MiddleAirFall）
priority = 3, Hit            ;攻撃優先度: 0 (最低) 7 (最高) 4がデフォルト・種類はHit/Miss/Dodge (デフォルト：Hit)
pausetime = 0, 4             ;攻撃を当てた時の自分と相手の硬直時間（自分,相手）
sparkno = 0                  ;ヒットスパーク (デフォルト：[Data]の項目で設定したモノが適用される) ★３
guard.sparkno = 40           ;ガードスパーク (デフォルト：[Data]の項目で設定したモノが適用される) ★３
sparkxy = -10, -60           ;ヒットスパークの位置（Ｘ軸,Ｙ軸）
hitsound = 5, 2              ;ヒットサウンド（Sを付けると自分のSNDファイルから）
guardsound = 6, 0            ;ガードサウンド（Sを付けないとMUGENデフォルトから）
ground.type = High           ;当たった時の地上の相手のアニメの属性　High：頭、体, Low：足, Trip：足払い
ground.slidetime = 5         ;当たった時の地上の相手がのけぞる時間
ground.hittime  = 24         ;当たった時の地上の相手のやられ状態の時間
ground.velocity = -4,0       ;当たった時の地上の相手の初速度（Ｘ軸,Ｙ軸）
airguard.velocity = -1.9,-.8 ;ガードされた時の空中の相手の初速度 (デフォルト：(air.xvel*1.5, air.yvel/2))
air.type = High              ;当たった時の空中の相手のアニメの属性: High, Low, Trip (デフォルト：ground.typeと同じになる)
air.velocity = -1.4,-3       ;当たった時の空中の相手の初速度（Ｘ軸,Ｙ軸）
air.hittime = 24             ;当たった時の空中の相手のやられ状態の時間

; ★３：数字の前に「s」を付けると自分のairファイルからアニメを呼び出す事が出来ます。
;       現在のデフォルトはヒットスパーク２、ガードスパーク４０です。

; ヒットスパークの種類(MUGENデフォルト)を説明すると、
;  0…小スパーク　1…中スパーク　2…大スパーク　3…特殊なスパーク
; 10…小血飛沫　 11…中血飛沫　 12…大血飛沫　 40…ガードスパーク　　というようになっている。
;
; 血飛沫は相手が例え機械でも出ますので、使用はほどほどに。

[State 210, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1000, 15

[State 220, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0 ;アニメーション時間が０、つまりアニメが終了した時に有効になります。
value = 2300

