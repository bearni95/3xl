[Statedef -2]

[State -2]
Type = VarRandom
TriggerAll = Alive = 1
TriggerAll = Time = 0
Trigger1 = StateNo = 5000
Trigger2 = StateNo = 5010
V = 1
Range = 0;,9

[State -2]
Type = PlaySnd
TriggerAll = Alive = 1
TriggerAll = Time = 1
TriggerAll = Var(1) = 0;[0,4]
Trigger1 = StateNo = 5000
Trigger1 = Anim   != [5000,5001] 
Trigger1 = Anim   != [5010,5011]
Trigger1 = Anim   != [5020,5021]
Trigger2 = StateNo = 5010
Trigger2 = Anim   != [5000,5001] 
Trigger2 = Anim   != [5010,5011]
Trigger2 = Anim   != [5020,5021]
Value = 1000, 1+Var(1)
Channel = 1


