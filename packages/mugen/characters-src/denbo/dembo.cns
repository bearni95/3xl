;------------------------------------------------------
; RUN_FWD
[StateDef 100]
Type = S
MoveType = I
Physics = N
Anim = 100
Ctrl = 1
VelSet = 0, 0
SprPriority = 1

[State 100, AssertSpecial]
Type = AssertSpecial
Trigger1 = 1
Flag = NoWalk
Flag2 = NoAutoTurn

[State 100, VelSet]
Type = VelSet
Trigger1 = Time = 5
X = Const(Velocity.Run.Fwd.X)

[State 100, PlaySnd]
Type = PlaySnd
Trigger1 = Time = 5
Value = 100, 0
Channel = 6

[State 100, Helper];ダッシュエフェクト
Type = null;Helper
Trigger1 = Time = 5
Persistent = 0
OwnPal = 1
Facing = 1
PosType = P1
Pos = -2, -35
ID = 30020
StateNo = 30020
Name = " "

[State 100, ChangeState]
Type = ChangeState
TriggerAll = Time > 16
Trigger1 = Command != "holdfwd"
Trigger2 = Time > 40
Value = 101

[State 100, ChangeState]
Type = ChangeState
TriggerAll = Time > 5
Trigger1 = Command = "holdfwd"
Trigger1 = Command = "holdup"
Value = 102

;Time = 6から移行可能

;停止
[StateDef 101]
Type = S
MoveType = I
Physics = N
Anim = 101
Ctrl = 0
SprPriority = 1

[State 101, AssertSpecial]
Type = AssertSpecial
Trigger1 = 1
Flag = NoWalk
Flag2 = NoAutoTurn

[State 101, ChangeState]
Type = ChangeState
Trigger1 = AnimTime = 0
Value = 0
Ctrl = 1

