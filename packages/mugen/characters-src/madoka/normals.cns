[Statedef 255]
type = A
movetype = A
physics = N
anim = 255
velset = 0,0
sprpriority = 2
ctrl = 0

[State 255, Screen]
type = turn
trigger1 = time = 1
trigger1 = frontedgebodydist <= 15

[State 257, fx]
type = playsnd
trigger1 = time = 0
value = 1,11
volume = 100


[State 255, Screen]
type = ScreenBound
trigger1 = 1
movecamera = 0,1

[State 255, 1]
type = Width
trigger1 = 1
edge = 20,20

[State 255, 0]
type = PosSet
trigger1 = Facing = 1
trigger1 = time > 0
trigger1 = backedgebodydist <= 20
x = -134

[State 255, 0]
type = PosSet
trigger1 = time > 0
trigger1 = Facing = -1
trigger1 = backedgebodydist <= 20
x = 134


[State 255, set]
type = VelSet
trigger1 = animTime = 0
x = 2.5
y = -8.6

[State 255, 6]
type = ChangeState
trigger1 = animtime = 0
value = 257
ctrl = 0



