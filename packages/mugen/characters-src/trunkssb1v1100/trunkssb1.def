; Definition file for Player
; Contains all the filenames needed for the character
; Template player 9X-09-12

; Character information
[Info]
name    = "Trunks";<-- Replace with a real name
displayname = "Trunks sb1";<-- Replace with name to display
author = "GohanSSM2"
;mugenversion = 4.01 & 4.14

; Files for the character
[Files]
cmd     = trunkssb1ai.cmd     ;Command set
cns     = trunkssb1.cns     ;Constants
st      = trunkssb1.cns     ;States
stcommon = aircodes.cns   ;Common states
sprite  = trunkssb1.sff     ;Sprite
anim    = trunkssb1.air     ;Animation
sound   = trunkssb1.snd     ;Sound
pal1    = trunkssb1.act     ;Palettes
pal2    = trunkssb1b.act
pal3    = trunkssb1c.act
pal4    = trunkssb1d.act
pal5    = trunkssb1e.act
pal6    = trunkssb1f.act