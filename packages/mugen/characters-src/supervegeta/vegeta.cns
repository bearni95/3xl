yaccel = .56          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 

[Quotes]
victory1 = "Oh my, someone's tired. But we're not done here, cause when I'm done...they'll need *tweezers* to pick up the pieces!!!!"
victory2 = "You're all going to suffer. You beg me for mercy, but stare into my eyes as I crush the life out of you!"
victory3 = "You are a fool! I'm going to crush you, and throw you into the wind! "
victory4 = "Hahaha! Look...you've been disarmed."
victory5 = "Damn it, Nappa."
victory6 = "Ya'll are bitches. "
victory7 = "Bitch, you just jealous of my Super Saiyan swagger! "
victory8 = "You know what? You better duck, because I'm about to turn left, and I don't wanna smack you with my....."
victory9 = "How dare you! I spoiled you! I spare your life & bless you with being a cripple & this is how you repay me!? Well, you can kiss it good bye!"
victory10 = "Being a good fiend is like being a photographer, you have to search for the right moments."
victory11 = "Humans, you're pathetic! I know Saiyan toddlers who could fight better!"
victory12 = "I think I made the universe a cleaner place to live."
victory13 = "Your body broke before I was done. Well, we will have to continue this another day..... When I see you in Hell."
victory14 = "It's not over till the fat lady sings. And guess what? I think I hear her humming."
victory15 = "Your entire race will die? Pity. I have no fuck's to spare."
victory16 = "I blew my load across your entire face. ....No homo. ...............freaky alien genotype."
victory17 = "THAT's IT!!! EVERYONE DIES!!!!!!!!!!"
victory18 = "I thought I'd be angrier, what with the utter humiliation & loss of my tail... Or maybe I'm just so unbelievably enraged that I've come full circle."
victory19 = "His power level, IT'S....................over 9,000. Rah."
victory20 = "I know you ate the last two tacos. With the NAMEKIAN PEPPER SAUCE!!!!!!!!!"
victory21 = "Yamcha? I don't know what this 'yamcha' is, but sounds alot like 'Raditz'."
Victory22 = "First immortality, then the bitches."
Victory23 = "I'd say you've hit your limit� behold� The overwhelming power of an elite Saiyan. "

victory78 = "Son of a gum-chewing funkmonster! Why the fruit does all this funny stuff happen to me? Forget my life! Always surrounded by miserable failing clods, like this whole world just likes to bend me over & find me in the Alps! Like I'm some sort of schlop receptacle. Well as far as I care these miserable cows can have a fancy barbecue with a pig!"
victory79 = "Look at yourself. Now back to me. Now look back at yourself. Back to me. I am not you. I'm flipping you off. Now look at the ground. Back to me. THERE IS NOT A DAMN THING YOU CAN DO! "
victory80 = "I'm gonna go pay your friends a...what was the word? [opponent: Visit?] BEATING!! Yes, I'm going to go pay them a beating."
victory81 = "It's not over till the fish jumps."
victory82 = "You will cook well over a proper fire pit. I'll make some of my special sauce."
victory83 = "You see yourself in me? Hah, how could you? You are so ugly, so weak, the only thing I should inspire in you is shame."
victory84 = "Strength is the only thing that matters in this world. Everything else is just a delusion for the weak."
victory85 = "I am a super-elite... the prince of all Saiyans. You are just a low-level! A common soldier. I am one of the greatest fighters in the universe!"
victory86 = "Don't be so soft. There's no stinking honor in any of this. It's just a game, play to win; There are no rules. "
victory87 = "The people here are ruthless savages. Warriors who do whatever it takes to win. And here you are, Mr. Nice Guy. They'll chew you up & spit you out with that attitude!"
victory88 = "Looks like you met with an unfortunate accident."
victory89 = "It would be pointless to let you continue to live. You were losing, which leads me to believe you weren't trying your hardest. I told you not to hold anything back. Goodbye."
victory90 = "Someone come clean this trash from the battlefield."
victory91 = "I, Vegeta, Prince of all Saiyans, would like to offer you the opportunity to stand beside me in conquest. I could use a good man. Think about it. Well, what do you say?"

