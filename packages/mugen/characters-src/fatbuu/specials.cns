getpower= ifelse(p2movetype=H,96,192), 48
fall=0
air.fall=1
forcestand=1
fall.recover=0
sprpriority=3
yaccel=.5
hitonce=1
p1stateno=2940
p2stateno=2950
kill=0

[State 2905, end]
type=changestate
trigger1= root,stateno!=2900 || root,movetype=H
trigger2= root,stateno=2900 && root,animelemtime(6)>=0
value=2906
ignorehitpause=1


[Statedef 2906]
type=A
physics=N
movetype=A
ctrl=0

[State 2906, end]
type=destroyself
trigger1=1


;---Food anims---
[Statedef 2940]
type=A
physics=N
movetype=I
anim=2940+(random%6)
ctrl=0
velset=0,0
sprpriority=1

[State 2940, bind]
type=turn
trigger1= numtarget(2900)
trigger1= facing != target(2900),facing

[State 2940, bind]
type=posset
trigger1= numtarget(2900)
x= ceil(target(2900),pos x)
y= ceil(target(2900),pos y+1)

[State 2940, angle]
type=angleset
trigger1= numtarget(2900)
trigger1= target(2900),stateno=2950 || target(2900),stateno=2952
value=0
[State 2940, spin]
type=angleset
trigger1= numtarget(2900)
trigger1= target(2900),stateno=2951
value= ceil(20 * cos(gametime/8.0*pi))
[State 2940, angle]
type=angledraw
trigger1=1
scale=1,1

[State 2940, walk]
type=playsnd
trigger1= numtarget(2900)
trigger1= target(2900),stateno=2951
value=5,37
channel=1
lowpriority=1
[State 2940, snd]
type=sndpan
trigger1= 1
channel=1
pan=0
[State 2940, walk]
type=stopsnd
trigger1= numtarget(2900)
trigger1= target(2900),stateno!=2951
channel=1

[State 2940, sparks]
type=explod
trigger1= (time=[1,29]) && !(time%4)
anim=f2
sprpriority=5
postype=p1
random=50,50
facing=ifelse(random<500,-1,1)
vfacing=ifelse(random<500,-1,1)
ownpal=1
pausemovetime=-1
supermovetime=-1

[State 2940, end]
type=changestate
trigger1= time>=120 || roundstate!=2
trigger2= !numtarget(2900)
trigger3= numtarget(2900)
trigger3= (target(2900),stateno!=[2950,2952]) || (target(2900),ishelper)
value=2941


