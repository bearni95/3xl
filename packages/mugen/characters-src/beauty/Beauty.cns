;---------------------------------------------------------------------------
; RUN_BACK
[StateDef 105]
Type = S
MoveType = I
Physics = N
Anim = 105
Ctrl = 1
VelSet = 0, 0
SprPriority = 1

[State 105, AssertSpecial]
Type = AssertSpecial
Trigger1 = 1
Flag = NoWalk
Flag2 = NoAutoTurn

[State 105, VelSet]
Type = VelSet
Trigger1 = Time = 5
X = -Const(Velocity.Run.Fwd.X)

[State 105, ChangeState]
Type = ChangeState
TriggerAll = Time > 16
Trigger1 = Command != "holdback"
Value = 0

