[Data]
life = 2000
attack = 100
defence = 110
fall.defence_up = 55
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = -150
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           
yscale = 1           
ground.back = 15     
ground.front = 16    
air.back = 12        
air.front = 12       
height = 60	     
attack.dist = 160    
proj.attack.dist = 90 
proj.doscale = 0       
head.pos = -5, -90   
mid.pos = -5, -60    
shadowoffset = 0     
draw.offset = 0,0    

[Velocity]
walk.fwd  = 1.5      
walk.back = -1.2    
run.fwd  = 6, 0    
run.back = -4.5,-3.8 
jump.neu = 0,-8    
jump.back = -2.5    
jump.fwd = 2.5       
runjump.back = -2.55,-8.1 
runjump.fwd = 4,-8.1      
airjump.neu = 0,-12      
airjump.back = -2.7      
airjump.fwd = 2.5         

[Movement]
airjump.num = 0      
airjump.height = 35  
yaccel = .44         
stand.friction = .85  
crouch.friction = .82 


;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
velset = 0,0
;anim = 170

[State 170, Assert]
type     = AssertSpecial
trigger1 = Time = [0,150]
flag     = roundnotover

[State 170]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

