;========================================================
; To turn Kikyo's Anti-cheapo mode on or off, scroll down
;========================================================

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]
[State -2, Anti Cheapo Mode On/Off]
type = VarSet
trigger1 = 1
v = 10
value = 1 ;0             ; Set this variable to 1 to activate Kikyo's
                         ; anti-cheapo mode whenever necessary. If set
                         ; to 0, Kikyo will not enter anti-cheapo mode
                         ; when fighting a cheap character.
                         ; Default value = 0

[State -2, Anti Cheapo Mode Active]
type = VarSet
trigger1 = (Enemy,Name = "Evil Ryu") && (Enemy,Authorname = "Reu and Kingtigre")
; Reu's Evil Ryu
trigger2 = (Enemy,Name = "Evil Ken") && (Enemy,Authorname = "Reu")
; Reu's Evil Ken
trigger3 = (Enemy,Name = "[Necromancer's] Broli") && (Enemy,Authorname = "The Necromancer")
; Necromancer's Broli
trigger4 = (Enemy,Name = "Pneophen's random experiment") && (Enemy,Authorname = "Pneophen")
; Pneophen's Cheap Boss Type
trigger5 = Enemy,Authorname = "gulthor"
; Gulthor's stolen Himan Zellode, Nightmare SSJ3, & Sephiroth
trigger6 = (Enemy,Name = "Mizuchi") && (Enemy,Authorname = "ahuron")
; Ahuron's God Orochi
trigger7 = (Enemy,Name = "Omega Zero") && (Enemy,Authorname = "N-Mario")
; N64Mario's Omega Zero
trigger8 = (Enemy,Name = "OmegaTH") && (Enemy,Authorname = "Neo Ankh & ShinRyoga")
; Omega Tom Hanks
trigger9 = (Enemy,Name = "ZERO_COL") && (Enemy,Authorname = "Zero_Col")
; Zero_Col

v = 11
value = 1

[State -2, Anticheapo Attack Boost]
type = AttackMulSet
triggerall = Var(10) != 0
trigger1 = Var(11) != 0
ignorehitpause = 1
value = 1.5 ; Gives Kikyo 150 Attack

[State -2, Anticheapo Defense Boost]
type = DefenceMulSet
triggerall = Var(10) != 0
trigger1 = Var(11) != 0
ignorehitpause = 1
value = 0.44 ; Gives Kikyo 225% Defense or 150 Defense & 1500 Life

[State -2, Anticheapo Speed]
type = VelMul
triggerall = Var(10) != 0
triggerall = Vel X != 0
triggerall = Var(11) != 0
trigger1 = StateNo = 20
trigger2 = StateNo = 40
x = 1.2

;[State -2, Anticheapo Gravity]
;type = VelAdd
;triggerall = Var(10) != 0
;triggerall = Vel Y != 0
;trigger1 = Var(11) != 0
;y = 0.2

[State -2, Anticheapo Heal]
type = LifeAdd
triggerall = Var(10) != 0
triggerall = Var(11) != 0
triggerall = StateNo = 2000 ; Can only heal when Curse Deflector is used
trigger1 = AnimElem = 16
value = 200
;absolute = 1

[State -2, Anticheapo Invincible]
type = NotHitBy
triggerall = Var(10) != 0
triggerall = Var(11) != 0
;trigger1 = StateNo = 2000 ; when Curse Deflector is used
trigger1 = MoveType = A
trigger2 = (Enemy,Name = "OmegaTH") && (Enemy,Authorname = "Neo Ankh & ShinRyoga")
; Always active if facing Omega Tom Hanks
value = SCA

[State -2, Anti Cheapo "Save the States!" Campaign]
type = VarSet
triggerall = Var(10) != 0
triggerall = Var(11) != 0
trigger1 = Life > 1
trigger1 = MoveType != H
trigger1 = StateNo != 9000
var(46) = StateNo

[State -2, Anti Cheapo Hyper Armor]
type = HitOverride
triggerall = Var(10) != 0
triggerall = Var(11) != 0
trigger1 = Random <= 1000
;trigger1 = MoveType != H
;trigger1 = Anim != 5300
;trigger1 = StateNo != [120,159]
;trigger1 = PrevStateNo != 9000
time = -1
slot = 7
attr = SCA,NA,AA,SA,HA,NP,AP,SP,HP,NT,AT,ST,HT
stateno = 9000
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]
;This controller plays a sound everytime Kikyo lands from a jump, or
;from her back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, Hitsound 1]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 500
triggerall = Life > 0 ;Too lazy to use Alive trigger
trigger1 = StateNo = 5000
trigger2 = StateNo = 5020
value = 5000, 0
channel = 0

[State -3, Hitsound 2]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 500
triggerall = Life > 0 ;Too lazy to use Alive trigger
trigger1 = StateNo = 5010
trigger2 = StateNo = 5030
trigger3 = StateNo = 5070
value = 5000, 1
channel = 0

[State -3, Kikyo gets up]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 750
triggerall = Life > 0 ;Too lazy to use Alive trigger
trigger1 = StateNo = 5120
value = 5120, 0
channel = 0
