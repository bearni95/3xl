trigger1 = time = 1
value = 12,12
volume = 0
channel = -1
;lowpriority = -1
freqmul = 1.0
loop = 0
pan = 0
;abspan =
;ignorehitpause =
;persistent =


[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

