trigger1 = 1
time = -1
attr = SCA, AA,AP,AT
slot = 0
stateno = 77745

[State 1200, 3]
type = changeanim
trigger1 = Time = 0
value = 77745

[State 58104, VelSet]
type = VelSet
trigger1 = time = [0,22]
x = 0
y = 0

[State 58104, VelSet]
type = VelSet
trigger1 = time = [23,227]
x = 0
y = 0

[State 1200, 4]
type = changestate
trigger1 = animtime = 0
value = 7775
ctrl = 0


