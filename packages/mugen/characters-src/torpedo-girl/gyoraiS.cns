hitsound = 5, 4              ;ヒットサウンド（Sを付けると自分のSNDファイルから）
guardsound = 6, 0            ;ガードサウンド（Sを付けないとMUGENデフォルトから）
ground.type = High           ;当たった時の地上の相手のアニメの属性　High：頭、体, Low：足, Trip：足払い
ground.slidetime = 5         ;当たった時の地上の相手がのけぞる時間
ground.hittime  = 40         ;当たった時の地上の相手のやられ状態の時間
ground.velocity = -6,-5       ;当たった時の地上の相手の初速度（Ｘ軸,Ｙ軸）
airguard.velocity = -1.9,-.8 ;ガードされた時の空中の相手の初速度 (デフォルト：(air.xvel*1.5, air.yvel/2))
air.type = High              ;当たった時の空中の相手のアニメの属性: High, Low, Trip (デフォルト：ground.typeと同じになる)
air.velocity = -5,-4       ;当たった時の空中の相手の初速度（Ｘ軸,Ｙ軸）
air.hittime = 40             ;当たった時の空中の相手のやられ状態の時間
p2facing = 1
fall = 1
fall.recovertime = 50 ;相手が吹っ飛び中に空中受け身が可能になるまでの時間（つまりその間は空中受け身不可）
yaccel = .4 ;ヒット時相手吹っ飛びのＹ軸方向に速度を加える

; ★３：数字の前に「s」を付けると自分のairファイルからアニメを呼び出す事が出来ます。
;       現在のデフォルトはヒットスパーク２、ガードスパーク４０です。

; ヒットスパークの種類(MUGENデフォルト)を説明すると、
;  0…小スパーク　1…中スパーク　2…大スパーク　3…特殊なスパーク
; 10…小血飛沫　 11…中血飛沫　 12…大血飛沫　 40…ガードスパーク　　というようになっている。
;
; 血飛沫は相手が例え機械でも出ますので、使用はほどほどに。

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0 ;アニメーション時間が０、つまりアニメが終了した時に有効になります。
value = 0
ctrl = 1 ;★４

;----------------------------------------------------------------------------

[Statedef 310]
type     = S                 ;キャラの状態を指定
                             ;S=立ち　C=しゃがみ　A=空中　L=倒れている　U=前のステートの状態を引き継ぐ
movetype = A                 ;キャラの行動内容を指定 I=何もしない　A=攻撃している　H=攻撃を食らっている
physics  = S                 ;キャラの物理的な体勢
                             ;S=立ち　C=しゃがみ　A=空中　N=重力や摩擦の影響を受けない　U=前のステートの体勢を引き継ぐ
anim     = 300               ;airファイルの[Begin Action 200]のアニメを使っています
sprpriority = 4              ;画像表示優先度　数値が多いと手前に、少ないと奥に優先されます

[State 210, ヒット定義]
type = HitDef                ;攻撃ヒット定義（Hit Definition）のステートコントローラ
trigger1 = Time = 0     ;攻撃判定ボックスがあればアニメーション３番目のコマで適用されます
attr = S, SA                 ;攻撃属性: これは Standing, Normal Attack（立ち通常攻撃）、重要項目です
damage = 0, 0               ;相手に与えるダメージ（ヒットした時,ガードされた時）
animtype = Hard             ;当たった時の相手のアニメの種類: Light, Medium, Hard, Back, Up, DiagUp
guardflag = MA               ;相手が立ち・しゃがみ・空中どのガードが出来るかを決めます（MiddleAir 全部ガードされます）
hitflag = MAF                ;相手がどの状態の時で攻撃を当てられるかを決めます（MiddleAirFall）
priority = 3, Hit            ;攻撃優先度: 0 (最低) 7 (最高) 4がデフォルト・種類はHit/Miss/Dodge (デフォルト：Hit)
pausetime = 0, 0             ;攻撃を当てた時の自分と相手の硬直時間（自分,相手）
sparkno = 1                  ;ヒットスパーク (デフォルト：[Data]の項目で設定したモノが適用される) ★３
guard.sparkno = 40           ;ガードスパーク (デフォルト：[Data]の項目で設定したモノが適用される) ★３
sparkxy = -10, -0           ;ヒットスパークの位置（Ｘ軸,Ｙ軸）
hitsound = 5, 3              ;ヒットサウンド（Sを付けると自分のSNDファイルから）
guardsound = 6, 0            ;ガードサウンド（Sを付けないとMUGENデフォルトから）
ground.type = Low           ;当たった時の地上の相手のアニメの属性　High：頭、体, Low：足, Trip：足払い
ground.slidetime = 5         ;当たった時の地上の相手がのけぞる時間
ground.hittime  = 40         ;当たった時の地上の相手のやられ状態の時間
ground.velocity = -8,0       ;当たった時の地上の相手の初速度（Ｘ軸,Ｙ軸）
airguard.velocity = -1.9,-.8 ;ガードされた時の空中の相手の初速度 (デフォルト：(air.xvel*1.5, air.yvel/2))
air.type = High              ;当たった時の空中の相手のアニメの属性: High, Low, Trip (デフォルト：ground.typeと同じになる)
air.velocity = 20,0       ;当たった時の空中の相手の初速度（Ｘ軸,Ｙ軸）
air.hittime = 40             ;当たった時の空中の相手のやられ状態の時間
p2stateno = 6000

