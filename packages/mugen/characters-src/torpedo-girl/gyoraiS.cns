[State 1000, 0]
type = Helper
trigger1 = Time = 14
helpertype = normal
name = "clash"
ID = 310
stateno = 310
pos = 16,-48
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 0
pausemovetime = 0
size.xscale = 2
size.yscale = 2

[State 220, ステート変更]
type = ChangeState
triggerall = Time >= 16
triggerall = P2StateNo = 6000
trigger1 = p2bodydist X < 80 ;アニメーション時間が０、つまりアニメが終了した時に有効になります。
value = 2200
ctrl = 1 ;★４

[State 220, ステート変更]
type = ChangeState
trigger1 = P2StateNo = 6000
trigger1 = Time = 150
trigger2 = P2StateNo != 6000
trigger2 = Time = 60 ;アニメーション時間が０、つまりアニメが終了した時に有効になります。
value = 0
ctrl = 1 ;★４

