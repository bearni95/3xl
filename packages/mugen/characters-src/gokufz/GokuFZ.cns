;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[statedef -2]

[State -2, Damage Dampener]; Scaling in action
type= attackmulset
trigger1= numenemy
trigger1= stateno != 2550
trigger1= stateno != 2000
value= ifelse(enemynear, gethitvar(hitcount) < 3, 24, ifelse(enemynear, gethitvar(hitcount) >= 5, 2, 26 - enemynear, gethitvar(hitcount))) / 16.0
ignorehitpause= 1

[State -2, Damage Dampener]; Full damage
type= attackmulset
trigger1= numenemy
trigger1= enemynear,movetype!=H || (enemynear,stateno=[120,155])
value= 1.0
ignorehitpause= 1

[State -2, Stop EX Glow]
type = Palfx
trigger1 = prevstateno = 1103
trigger2 = prevstateno = 1205
trigger2 = stateno != 1206
trigger3 = prevstateno = 1206
trigger3 = stateno != 1207
trigger4 = prevstateno = 1207
time = 0
ignorehitpause = 1

[State -2,弹墙特效]
type = Helper
trigger1 = !numhelper(823)
trigger1 = p2stateno = 822 && enemy,time = 1
trigger1 = P2movetype =H
helpertype = normal
ID =  823
stateno = 823
pos = -10,-70
postype = P2
facing = -1
keyctrl = 0
ownpal = 0
supermovetime = 1
pausemovetime = 1
name = "弹墙特效"
size.xscale = 0.5
size.yscale = 0.5
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, GetHit Sound]
type=playsnd
triggerall= alive && time=1
triggerall= stateno=5000 || stateno=5010
trigger1= gethitvar(animtype)>=2 && random<500
trigger2= gethitvar(animtype)=1 && random<375
trigger3= gethitvar(animtype)=0 && random<250
value=5000,0+(random%6)
volume = 200
channel=0
ignorehitpause=1

[State -3, GetHit Sound]
type=playsnd
triggerall= alive && time=1
trigger1= (stateno=5000 || stateno=5010) && numenemy
trigger1= gethitvar(fall) || (enemynear,hitdefattr=SCA,SA,HA)
trigger2= (stateno=5020 || stateno=5070 || stateno=5080)
trigger3= (stateno=5050 || stateno=5100) && (prevstateno!=[5000,5199])
value=5000,0+(random%6)
volume = 200
channel=0
ignorehitpause=1

[State -3, Jump Sound]
type = PlaySnd
triggerall = Time = 0
trigger1 = stateno = 40 ;Jump Start
value = 40, 1

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
value = 40, 0

[State 0, ChangeState]
type = posset
triggerall = Pos Y > 0
trigger1 = time = 0
y = 0

[State -3, PowerAdd]
type = powerAdd
triggerall = var(0) = 77
trigger1 = ((GameTime%2) = 0)
value = 2
;absolute = 0
ignorehitpause = 1
persistent = 1

[State -3, 2OS]
type=stopsnd
trigger1 = prevstateno = 191 && time <= 1
trigger2 = prevstateno = 192 && time <= 1
trigger3 = prevstateno = 193 && time <= 1
trigger4 = prevstateno = 194 && time <= 1
trigger5 = prevstateno = 196 && time <= 1
trigger6 = prevstateno = 198 && time <= 1
trigger7 = prevstateno = 199 && time <= 1
channel = 7
ignorehitpause = 1
persistent = 1

[State -3, VarAdd]
type = VarAdd
triggerall = var(1) > 0
trigger1 = stateno = 5001
trigger1 = anim = 5000
trigger2 = stateno = 5001
trigger2 = anim = 5010
trigger3 = stateno = 5011
trigger3 = anim = 5020
var(1) = -1
ignorehitpause = 1
persistent = 0

[State -3, VarAdd]
type = VarAdd
triggerall = var(1) > 0
trigger1 = stateno = 5001
trigger1 = anim = 5001
trigger2 = stateno = 5001
trigger2 = anim = 5011
trigger3 = stateno = 5011
trigger3 = anim = 5021
var(1) = -3
ignorehitpause = 1
persistent = 0

[State -3, VarAdd]
type = VarAdd
triggerall = var(1) > 0
trigger1 = stateno = 5001
trigger1 = anim = 5002
trigger2 = stateno = 5001
trigger2 = anim = 5012
trigger3 = stateno = 5011
trigger3 = anim = 5022
var(1) = -6
ignorehitpause = 1
persistent = 0

[State -3, VarAdd]
type = VarAdd
trigger1 = var(1) > 0
trigger1 = PrevStateNo = 5050
var(1) = -10
ignorehitpause = 1
persistent = 0

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0
