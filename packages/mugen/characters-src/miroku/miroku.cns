projremove = -2
projremovetime = 52
velocity = (Fvar(13)/fvar(15)) * 9.0, (FVar(14)/fvar(15)) * 9.0 ;Normalizes the components
remvelocity = 0,0
accel = 0,0
velmul = 1
projhits = 1
projpriority = 1
projsprpriority = 3
projedgebound = 1000
offset = var(3),var(4)
postype = p1         ;p2,front,back,left,right
projshadow = 0,0,0
; HitDef
