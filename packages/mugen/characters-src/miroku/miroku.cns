;----------------------------------------------------------------------------
;Parry P2
[StateDef 902]
type = S
movetype = H
physics = S
velset = 0,0
sprpriority = 0
ctrl = 0

[State 902, PosSet]
type = PosSet
trigger1 = pos y > 0
y = 0

[State 902, VelSet]
type = VelSet
trigger1 = pos y < 0 && time>10
x = -6
y = -3

[State 902, SelfState]
type = SelfState
trigger1 = pos y < 0 && time>10
value = 5050

[State 902, VelSet]
type = VelSet
triggerall = time>10
trigger1 = abs(AnimTime) = 19
x = -4

[State 902, VelSet]
type = VelSet
triggerall = time>10
trigger1 = abs(AnimTime) != 19
x = -1

[State 902, ChangeAnim]
type = ChangeAnim
