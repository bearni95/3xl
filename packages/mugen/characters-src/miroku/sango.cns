;Sango Assist
[StateDef 40000]
type = A
movetype = I
physics = N
anim = 21100
velset = 10,-10
sprpriority = 3

[State 40000, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay
ignorehitpause = 1

[State 40000, BGPalFX]
type = BGPalFX
trigger1 = 1
time = 1
add = -256+floor(cos(time*.029)*256), -256+floor(cos(time*.029)*256), -256+floor(cos(time*.029)*256)
mul = 256,256,256
sinadd = 0,0,0,10
invertall = 0
color = 256
ignorehitpause = 1
;persistent =

[State 40000, PlaySnd]
type = PlaySnd
trigger1 = !time
value = 40,1

[State 40000, Gravity]
type = Gravity
trigger1 = pos y < 0

[State 40000, VelSet]
type = VelSet
trigger1 = pos y > 0
y = 0
x = 0

[State 40000, PosSet]
type = PosSet
trigger1 = pos y > 0
y = 0

[State 40000, ChangeState]
type = ChangeState
trigger1 = pos y = 0
value = 40001

