;-----------------------------------------------------------------------
;Hiraikotsu
[StateDef 40003]
type = A
movetype = A
physics = N
anim = 21103
sprpriority = 2
velset = 10,0

[State 40000, PlaySnd]
type = PlaySnd
trigger1 = !time
value = 40,2

[State 40003, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 40003, AngleDraw]
type = AngleDraw
trigger1 = 1
value = -time * 40
ignorehitpause = 1

[State 1001, VelSet]
type = VelSet
trigger1 = time>30
x = -10*(time>50)

[State 40003, HitDef]
type = HitDef
trigger1 = !time
attr = A, SP
animtype  = Medium
damage    = 250,30
guardflag = MA
pausetime = 0,10
sparkno = S20000
guard.sparkno = S20001
sparkxy = 0,0
hitsound   = S0, 22
guardsound = S0, 1
ground.type = Trip
ground.slidetime = 12
ground.hittime  = 20
ground.velocity = -6,-5
air.velocity = -6.2,-4.2
fall = 1
air.fall = 1
getpower = 0
hitonce = 0

[State 40003, DestroySelf]
type = DestroySelf
trigger1 = time > 80 || parent,stateno!=40002

