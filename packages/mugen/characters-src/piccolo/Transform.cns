[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 1
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 10041 && anim <= 10043
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 2
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 20041 && anim <= 20043
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 3
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 30041 && anim <= 30043
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 4
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 40041 && anim <= 40043
persistent = 0
value = Anim + 3

[State 50, 3]
