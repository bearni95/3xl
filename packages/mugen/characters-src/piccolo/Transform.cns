; Stand / Tired Stand
[Statedef 7001]
type = S
physics = S
sprpriority = 0

[State 240, 4]
type = ChangeState
triggerall = Var(10) = 1
triggerall = Var(11) = 0
trigger1 = 1
value = 7012
ctrl = 0

[State 0, Explod]
type = Explod
trigger1 = time%40=0
anim = 904
ID = 902
pos = 0,15
postype = p1
removetime = -2
pausemovetime = 285
supermovetime = 285
scale = 1,1
sprpriority = 5
ownpal = 1
removeongethit = 1

[State 0, Standing animation / Tired animation]
Type = ChangeAnim
Trigger1 = Anim != IfElse (Life <= 400, 3, 2) && Anim != 13
Trigger2 = Anim = 7003 && AnimTime = 0 ;Turn anim over
Value = IfElse (Life <= 400 , 3, 2)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

