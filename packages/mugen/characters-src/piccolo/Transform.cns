; Walk
[Statedef 7005]
type    = S
physics = S
sprpriority = 0

[State 240, 4]
type = ChangeState
trigger1 = Var(11) = 0
value = 7012
ctrl = 0

[State 0, Explod]
type = Explod
triggerall = anim = 7006 || anim=10020
trigger1 = timemod=8,0
anim = 110
pos = -18,0
postype = p1
removetime=-2
facing = 1
vel = -1,-.5
random = 20,20
scale = 0.15,0.15
sprpriority = 3

[State 0, Explod]
type = Explod
triggerall = anim = 7007 || anim=10021
trigger1 = timemod=8,0
anim = 110
pos = 18,0
postype = p1
removetime=-2
facing = 1
vel = 1,-.5
random = 20,20
scale = 0.15,0.15
sprpriority = 3

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = var(7) = 0
triggerall = vel x > 0
trigger1 = Anim != 22 
value = 22

[State 20, 4]
type = ChangeAnim
triggerall = var(7) = 0
triggerall = vel x < 0
trigger1 = Anim != 23
value = 23

[State 20, 4]
type = Changestate
triggerall = var(7) = 0
triggerall = vel x = 0
trigger1 = Anim != 2
value = 2

