;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 0, Explod]
type = Explod
triggerall = anim = 20 || anim=10020
trigger1 = timemod=8,0
anim = 110
pos = -18,0
postype = p1
removetime=-2
facing = 1
vel = -1,-.5
random = 20,20
scale = 0.15,0.15
sprpriority = 3

[State 0, Explod]
type = Explod
triggerall = anim = 21 || anim=10021
trigger1 = timemod=8,0
anim = 110
pos = 18,0
postype = p1
removetime=-2
facing = 1
vel = 1,-.5
random = 20,20
scale = 0.15,0.15
sprpriority = 3

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = var(7) = 0
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = var(7) = 0
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, 3]
type = ChangeAnim
triggerall = var(7) = 1
triggerall = vel x > 0
trigger1 = Anim != 10020 && Anim != 10005
trigger2 = Anim = 10005 && AnimTime = 0
value = 10020

[State 20, 4]
type = ChangeAnim
triggerall = var(7) = 1
triggerall = vel x < 0
trigger1 = Anim != 10021 && Anim != 10005
trigger2 = Anim = 10005 && AnimTime = 0
value = 10021

[State 20, 3]
type = ChangeAnim
triggerall = var(7) = 2
triggerall = vel x > 0
trigger1 = Anim != 20020 && Anim != 20005
trigger2 = Anim = 20005 && AnimTime = 0
value = 20020

[State 20, 4]
type = ChangeAnim
triggerall = var(7) = 2
triggerall = vel x < 0
trigger1 = Anim != 20021 && Anim != 20005
trigger2 = Anim = 20005 && AnimTime = 0
value = 20021

[State 20, 3]
type = ChangeAnim
triggerall = var(7) = 3
triggerall = vel x > 0
trigger1 = Anim != 30020 && Anim != 30005
trigger2 = Anim = 30005 && AnimTime = 0
value = 30020

[State 20, 4]
type = ChangeAnim
triggerall = var(7) = 3
triggerall = vel x < 0
trigger1 = Anim != 30021 && Anim != 30005
trigger2 = Anim = 30005 && AnimTime = 0
value = 30021

[State 20, 3]
type = ChangeAnim
triggerall = var(7) = 4
triggerall = vel x > 0
trigger1 = Anim != 40020 && Anim != 40005
trigger2 = Anim = 40005 && AnimTime = 0
value = 40020

[State 20, 4]
type = ChangeAnim
triggerall = var(7) = 4
triggerall = vel x < 0
trigger1 = Anim != 40021 && Anim != 40005
trigger2 = Anim = 40005 && AnimTime = 0
value = 40021

[State 20, 3]
type = ChangeAnim
triggerall = var(7) = 5
triggerall = vel x > 0
trigger1 = Anim != 50020 && Anim != 50005
trigger2 = Anim = 50005 && AnimTime = 0
value = 50020

[State 20, 4]
type = ChangeAnim
triggerall = var(7) = 5
triggerall = vel x < 0
trigger1 = Anim != 50021 && Anim != 50005
trigger2 = Anim = 50005 && AnimTime = 0
value = 50021


;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = command = "Explosive WaveW"
value = 1400
ctrl = 0

[State 0]
type = Explod
trigger1 = time = [0,10]
anim = 110
pos = 0,2
postype = p1
facing = 1
scale = 0.15,0.15
vel = -2,-.5
random = 50,10
sprpriority = 1

[State 0]
type = Explod
trigger1 = time = [0,10]
anim = 110
pos = 0,2
postype = p1
facing = 1
scale = 0.15,0.15
vel = 2,-.5
random = 50,10
sprpriority = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time=1
value = S40,1
volume =255

[State 40, 1]
type = changeanim
triggerall = var(7) = 0
trigger1 = time = 0
value = 40

[State 40, 1]
type = changeanim
triggerall = var(7) = 1
trigger1 = time = 0
value = 10040

[State 40, 1]
type = changeanim
triggerall = var(7) = 2
trigger1 = time = 0
value = 20040

[State 40, 1]
type = changeanim
triggerall = var(7) = 3
trigger1 = time = 0
value = 30040

[State 40, 1]
type = changeanim
triggerall = var(7) = 4
trigger1 = time = 0
value = 40040

[State 40, 1]
type = changeanim
triggerall = var(7) = 5
trigger1 = time = 0
value = 50040

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S0,20
volume = 200

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 1
value = S1,0
volume = 200

[State 45, 1]
type = ChangeAnim
triggerall = var(7) = 0
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 1]
type = ChangeAnim
triggerall = var(7) = 1
trigger1 = SelfAnimExist(10044)
value = 10044

[State 45, 1]
type = ChangeAnim
triggerall = var(7) = 2
trigger1 = SelfAnimExist(20044)
value = 20044

[State 45, 1]
type = ChangeAnim
triggerall = var(7) = 3
trigger1 = SelfAnimExist(30044)
value = 30044

[State 45, 1]
type = ChangeAnim
triggerall = var(7) = 4
trigger1 = SelfAnimExist(40044)
value = 40044

[State 45, 1]
type = ChangeAnim
triggerall = var(7) = 5
trigger1 = SelfAnimExist(50044)
value = 50044

[State 45, 2]
type = ChangeAnim
triggerall = var(7) = 0
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 2]
type = ChangeAnim
triggerall = var(7) = 1
trigger1 = !SelfAnimExist(10044)
value = 10041

[State 45, 2]
type = ChangeAnim
triggerall = var(7) = 2
trigger1 = !SelfAnimExist(20044)
value = 20041

[State 45, 2]
type = ChangeAnim
triggerall = var(7) = 3
trigger1 = !SelfAnimExist(30044)
value = 30041

[State 45, 2]
type = ChangeAnim
triggerall = var(7) = 4
trigger1 = !SelfAnimExist(40044)
value = 40041

[State 45, 2]
type = ChangeAnim
triggerall = var(7) = 5
trigger1 = !SelfAnimExist(50044)
value = 50041

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 1
value = S40,1
volume = 200

[State 0, Explod]
type = Explod
trigger1 = animelem  = 1
anim = 112
pos = 0,2
postype = p1  ;p2,front,back,left,right
facing = 1
scale = 0.8,0.8
sprpriority = 1

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
triggerall = var(7) = 0
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 2]
type = ChangeAnim
triggerall = var(7) = 1
trigger1 = Time = 0
value = ifelse((vel x)=0, 10041, ifelse((vel x)>0, 10042, 10043))

[State 50, 2]
type = ChangeAnim
triggerall = var(7) = 2
trigger1 = Time = 0
value = ifelse((vel x)=0, 20041, ifelse((vel x)>0, 20042, 20043))

[State 50, 2]
type = ChangeAnim
triggerall = var(7) = 3
trigger1 = Time = 0
value = ifelse((vel x)=0, 30041, ifelse((vel x)>0, 30042, 30043))

[State 50, 2]
type = ChangeAnim
triggerall = var(7) = 4
trigger1 = Time = 0
value = ifelse((vel x)=0, 40041, ifelse((vel x)>0, 40042, 40043))

[State 50, 2]
type = ChangeAnim
triggerall = var(7) = 5
trigger1 = Time = 0
value = ifelse((vel x)=0, 50041, ifelse((vel x)>0, 50042, 50043))

[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 0
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 1
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 10041 && anim <= 10043
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 2
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 20041 && anim <= 20043
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 3
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 30041 && anim <= 30043
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 4
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 40041 && anim <= 40043
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = var(7) = 5
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 50041 && anim <= 50043
persistent = 0
value = Anim + 3


