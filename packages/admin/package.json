{
	"name": "@3xl/admin",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Admin authoring SPA (character definitions + TMDB shows). Static build; edits @3xl/data through the @3xl/backend API.",
	"scripts": {
		"dev": "vite dev --port 2001 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 2001 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"clean": "rm -rf dist .svelte-kit"
	},
	"dependencies": {
		"@3xl/assets": "workspace:*",
		"@3xl/data": "workspace:*",
		"@3xl/shared": "workspace:*",
		"@sveltejs/adapter-static": "^3.0.9",
		"chart.js": "^4.5.1",
		"classnames": "^2.5.1",
		"pixi.js": "^8.19.0",
		"svelte-i18n": "^4.0.1"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/geojson": "^7946.0.16",
		"daisyui": "^5.0.50",
		"eslint": "^9.18.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	}
}
