# TMDB API Key for fetching movie/TV show metadata
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional v4 read access token (Bearer auth). Not required when TMDB_API_KEY is set.
TMDB_READ_ACCESS_TOKEN=

# Supabase (client-side auth for the /profile page).
# Find these in your Supabase project: Settings -> API.
# They are safe to expose to the browser (PUBLIC_ prefix); the anon key is
# gated by Row Level Security, not secrecy.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
